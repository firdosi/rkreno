# Install as /etc/rkreno/form-api.env with mode 600 and root ownership.
FORM_API_HOST=127.0.0.1
FORM_API_PORT=8787

ALLOWED_ORIGINS=https://preview-host.example,https://rkrenosolution.com,https://www.rkrenosolution.com
TURNSTILE_EXPECTED_HOSTNAMES=preview-host.example,rkrenosolution.com,www.rkrenosolution.com
TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret

ENQUIRY_TO_EMAIL=rkrenosolution@gmail.com
ENQUIRY_FROM_EMAIL=RK Reno Website <website@rkrenosolution.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password-or-api-key

RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=900
