---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="utility-page" aria-labelledby="confirmation-title">
  <div class="wrap utility-card">
    <p class="eyebrow">Enquiry confirmation</p>
    <h1 id="confirmation-title" tabindex="-1">Thank You</h1>
    <p>
      If you reached this page after a successful production form submission, your
      enquiry was accepted. A direct visit or staging test does not confirm that an
      enquiry was sent.
    </p>
    <p>
      If you still need to contact RK Reno Solution, call
      <a href="tel:+601111334496" data-track="phone">+60 11 1133 4496</a> or use
      <a href="https://wa.me/601111334496" data-track="whatsapp">WhatsApp</a>.
    </p>
    <div class="button-row">
      <a class="button" href={`${base}/`}>Back to homepage</a>
      <a class="utility-link" href={`${base}/services/`}>Browse services</a>
    </div>
  </div>
</section>

<script>
  document.querySelector<HTMLElement>('#confirmation-title')?.focus();
</script>
