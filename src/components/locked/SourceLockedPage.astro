---
import { createSourceMediaResolver, localRouteHref } from '../../lib/source-content';
import SourceBlock from './SourceBlock.astro';

const { record, page, kind = 'page', featuredImage = '', featuredAlt = '' } = Astro.props as any;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const blocks = record.content.orderedBlocks || [];
const heroIndex = blocks.findIndex((block) => block.type === 'heading' && block.level === 1);
const leadIndex = blocks.findIndex((block) => block.type === 'p' && block.text);
const heroTitle = record.content.h1 || record.seo.title;
const lead = leadIndex >= 0 ? blocks[leadIndex].text : record.seo.description;
const body = blocks.filter((_, index) => index !== heroIndex && index !== leadIndex);
const toc = body.filter((block) => block.type === 'heading' && block.text && block.level <= 2)
  .map((block, index) => ({ ...block, id: `source-section-${index + 1}` }));
const resolveMedia = createSourceMediaResolver(page.images || []);
const sourceHeroBlock = body.find((block) => block.type === 'image' && !/gravatar/i.test(block.src));
const heroImage = sourceHeroBlock ? resolveMedia(sourceHeroBlock.src) : featuredImage;
const heroAlt = sourceHeroBlock?.alt || featuredAlt || '';
const contentBody = sourceHeroBlock ? body.filter((block) => block !== sourceHeroBlock) : body;
const sections = [];
let currentSection = { blocks: [] };
for (const block of contentBody) {
  if (block.type === 'heading' && block.level <= 2 && currentSection.blocks.length) {
    sections.push(currentSection);
    currentSection = { blocks: [] };
  }
  currentSection.blocks.push(block);
}
if (currentSection.blocks.length) sections.push(currentSection);
let tocCursor = 0;
const published = record.content.dates?.[0] || page.published || '';
const dateLabel = published ? new Date(published).toLocaleDateString('en-MY', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
const related = [...new Map((record.content.internalLinks || [])
  .filter((link) => link.text && !['Home', 'Read more', 'No Comments'].includes(link.text))
  .map((link) => [link.href, link])).values()].slice(0, 6);
---
<article class:list={['source-locked-page', `source-locked-${kind}`]}>
  <header class="source-locked-hero">
    <div class="source-locked-wrap source-locked-hero-grid">
      <div>
        <p class="source-locked-kicker">{kind === 'article' ? 'RK RENO GUIDE' : kind === 'service' ? 'RK RENO SERVICE' : 'RK RENO SOLUTION'}</p>
        <h1>{heroTitle}</h1>
        {lead && <p class="source-locked-lead">{lead}</p>}
        <div class="source-locked-actions">
          <a class="source-locked-primary" href="https://wa.me/601111334496">Discuss Your Requirements</a>
          <a class="source-locked-secondary" href={`${base}/contact-us/`}>Contact RK Reno</a>
        </div>
      </div>
      <aside class="source-locked-hero-aside" aria-label="Page information">
        {heroImage && <img class="source-locked-hero-media" src={`${base}${heroImage}`} alt={heroAlt} width="720" height="540" />}
        <div class="source-locked-hero-note">
          <span>Source-verified content</span>
          {dateLabel && <time datetime={published}>{dateLabel}</time>}
          {record.content.author && <span>By {record.content.author}</span>}
          <span>Kuala Lumpur &amp; Selangor</span>
        </div>
      </aside>
    </div>
  </header>

  <div class="source-locked-wrap source-locked-layout">
    <main class="source-locked-body">
      {toc.length >= 3 && (
        <nav class="source-locked-toc" aria-label="On this page">
          <p>On this page</p>
          <ol>{toc.map((item) => <li><a href={`#${item.id}`}>{item.text}</a></li>)}</ol>
        </nav>
      )}
      {sections.map((section, sectionIndex) => (
        <section class:list={['source-locked-section', { 'source-locked-section-accent': sectionIndex % 3 === 1 }]}>
          {section.blocks.map((block) => <SourceBlock block={block} base={base} resolveMedia={resolveMedia} headingId={block.type === 'heading' && block.level <= 2 ? toc[tocCursor++]?.id : undefined} />)}
        </section>
      ))}
    </main>
    <aside class="source-locked-sidebar">
      <section><p class="source-locked-kicker">PROJECT ENQUIRY</p><h2>Plan the next step</h2><p>Share the location, photos and required scope. A quotation depends on the confirmed site conditions, materials and access.</p><a href="https://wa.me/601111334496">WhatsApp RK Reno</a></section>
      {related.length > 0 && <nav aria-label="Related source links"><h2>Related pages</h2>{related.map((link) => <a href={localRouteHref(link.href, base)}>{link.text}</a>)}</nav>}
    </aside>
  </div>
</article>
