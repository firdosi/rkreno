---
import RecoveryHero from '../../core-recovery/RecoveryHero.astro';
import RecoverySectionHeading from '../../core-recovery/RecoverySectionHeading.astro';
import RecoveryServiceCard from '../../core-recovery/RecoveryServiceCard.astro';
import RecoveryCta from '../../core-recovery/RecoveryCta.astro';
import { cardFromRecord } from '../locked-page-data';
import { coreMedia, serviceMediaByRoute } from '../../../data/core-page-design';
const { record, allRecords, pageByRoute } = Astro.props as any;
const recordByRoute = new Map(allRecords.map((item: any) => [item.route, item]));
const card = (route: string) => cardFromRecord(recordByRoute.get(route), pageByRoute);
---
<article class="source-locked-page recovery-page recovery-services-page" data-locked-template="services-hub">
  <RecoveryHero eyebrow="Services across KL & Selangor" title={record.content.h1} lead={record.content.paragraphs[0]} image={coreMedia.commercial} alt="Renovation contractor working on a commercial property" compact />
  <section class="recovery-section recovery-service-intro"><div class="recovery-wrap"><RecoverySectionHeading eyebrow="Priority services" title="Start with the work your property needs now" lead={record.content.paragraphs[1]} align="center" /><div class="recovery-service-grid">{['/aircond-installation-kl/','/house-renovation-in-kuala-lumpur/','/office-renovation-in-kuala-lumpur/'].map((route) => <RecoveryServiceCard card={card(route)} image={serviceMediaByRoute[route]} />)}</div></div></section>
  <section class="recovery-section recovery-service-group recovery-section-warm"><div class="recovery-wrap"><RecoverySectionHeading eyebrow="Cooling and maintenance" title="Aircond services" lead="Compare servicing, Kuala Lumpur installation and Selangor installation without mixing prices or inclusions." /><div class="recovery-service-grid">{['/servis-aircond-murah-kl/','/aircond-installation-kl/','/upah-pasang-aircond-selangor/'].map((route) => <RecoveryServiceCard card={card(route)} image={serviceMediaByRoute[route]} />)}</div></div></section>
  <section class="recovery-section recovery-service-group"><div class="recovery-wrap"><RecoverySectionHeading eyebrow="Homes, offices and buildings" title="Renovation services" lead="Plan room upgrades, multi-trade renovation, commercial fit-out or a wider building scope around the actual property." /><div class="recovery-service-grid">{['/house-renovation-in-kuala-lumpur/','/house-renovation-in-selangor/','/home-renovation-contractor-in-subang-jaya/','/office-renovation-in-kuala-lumpur/','/service/building-renovation/'].map((route) => <RecoveryServiceCard card={card(route)} image={serviceMediaByRoute[route]} />)}</div></div></section>
  <section class="recovery-section recovery-image-split recovery-section-navy"><div class="recovery-wrap"><img src={serviceMediaByRoute['/demolition-contractor-kl-selangor/']} alt="Interior site relevant to controlled demolition and preparation" width="760" height="560" loading="lazy" /><div><RecoverySectionHeading eyebrow="Demolition and preparation" title="Remove carefully before rebuilding" lead="Review controlled strip-out, bathroom or kitchen removal, debris handling and preparation for the next renovation phase." /><a class="recovery-button recovery-button-primary" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/demolition-contractor-kl-selangor/`}>Explore demolition scope</a></div></div></section>
  <section class="recovery-section recovery-service-group recovery-section-warm"><div class="recovery-wrap"><RecoverySectionHeading eyebrow="Technical and protective work" title="Electrical and specialist services" lead="Start with inspection, symptoms and site conditions before choosing the work method." /><div class="recovery-service-grid">{['/electrical-services-selangor/','/waterproofing-contractor-kuala-lumpur/','/plaster-ceiling-contractor-kl/'].map((route) => <RecoveryServiceCard card={card(route)} image={serviceMediaByRoute[route]} />)}</div></div></section>
  <section class="recovery-section recovery-image-split"><div class="recovery-wrap"><div><RecoverySectionHeading eyebrow="Property cleaning" title="Cleaning after moving, living or renovation" lead="Agree the property size, condition, priority rooms, access limits and checklist before booking." /><a class="recovery-button recovery-button-primary" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/servis-cuci-rumah-kl/`}>Review cleaning packages</a></div><img src={serviceMediaByRoute['/servis-cuci-rumah-kl/']} alt="Detailed kitchen cleaning service in Kuala Lumpur" width="760" height="560" loading="lazy" /></div></section>
  <section class="recovery-section recovery-section-navy"><div class="recovery-wrap"><RecoverySectionHeading eyebrow="Work process" title="A clear route from enquiry to handover" align="center" /><div class="recovery-process-grid">{[['01','Share the requirement','Send the location, photos, measurements and required outcome.'],['02','Review the property','Check access, conditions, quantities and any building rules.'],['03','Confirm scope and quote','Review inclusions, exclusions, pricing and additional rates.'],['04','Complete and hand over','Carry out the agreed work and review the result.']].map(([number,title,text]) => <article><span>{number}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
  <section class="recovery-section recovery-location-section"><div class="recovery-wrap"><div><RecoverySectionHeading eyebrow="Service coverage" title="Kuala Lumpur, Selangor and nearby areas" lead="Availability depends on location, scope and schedule. Share the postcode or neighbourhood when requesting a quotation." /><div class="recovery-chips">{['Kuala Lumpur','Setapak','Wangsa Maju','Cheras','Bangsar','Kepong','Petaling Jaya','Shah Alam','Subang Jaya'].map((area) => <span>{area}</span>)}</div></div><img src={coreMedia.areas} alt="Service coverage map for Kuala Lumpur and Selangor" width="640" height="460" loading="lazy" /></div></section>
  <RecoveryCta title="Not sure which service fits your project?" text="Share the property location, photos and required outcome so RK Reno can guide you toward the relevant service and quotation process." />
</article>
