---
import RecoveryHero from '../../core-recovery/RecoveryHero.astro';
import RecoverySectionHeading from '../../core-recovery/RecoverySectionHeading.astro';
import RecoveryServiceCard from '../../core-recovery/RecoveryServiceCard.astro';
import RecoveryCta from '../../core-recovery/RecoveryCta.astro';
import { cardFromRecord } from '../locked-page-data';
import { coreMedia, serviceGroups, serviceMediaByRoute } from '../../../data/core-page-design';
const { record, allRecords, pageByRoute } = Astro.props as any;
const recordByRoute = new Map(allRecords.map((item: any) => [item.route, item]));
const card = (route: string) => cardFromRecord(recordByRoute.get(route), pageByRoute);
---
<article class="source-locked-page recovery-page recovery-services-page" data-locked-template="services-hub">
  <RecoveryHero eyebrow="Services across KL & Selangor" title={record.content.h1} lead={record.content.paragraphs[0]} image={coreMedia.commercial} alt="Renovation contractor working on a commercial property" compact />
  <section class="recovery-section recovery-service-intro"><div class="recovery-wrap"><RecoverySectionHeading eyebrow="Complete service directory" title="Find the right service for your space" lead={record.content.paragraphs[1]} align="center" /></div></section>
  {serviceGroups.map((group, index) => <section class:list={['recovery-section', 'recovery-service-group', { 'recovery-section-warm': index % 2 === 1 }]}><div class="recovery-wrap">
    <RecoverySectionHeading eyebrow="Service category" title={group.title} />
    <div class="recovery-service-grid">{group.routes.map((route) => { const item = card(route); return <RecoveryServiceCard card={item} image={serviceMediaByRoute[route]} />; })}</div>
  </div></section>)}
  <RecoveryCta title="Not sure which service fits your project?" text="Share the property location, photos and required outcome so RK Reno can guide you toward the relevant service and quotation process." />
</article>
