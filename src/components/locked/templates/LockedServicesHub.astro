---
import LockedHero from '../LockedHero.astro';
import LockedContentSections from '../LockedContentSections.astro';
import { cardFromRecord, prepareLockedPage, SERVICE_ROUTES } from '../locked-page-data';
const { record, page, allRecords, pageByRoute } = Astro.props as any;
const data = prepareLockedPage(record, page);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cards = allRecords.filter((item: any) => SERVICE_ROUTES.has(item.route)).map((item: any) => cardFromRecord(item, pageByRoute));
---
<article class="source-locked-page locked-services-hub" data-locked-template="services-hub">
  <LockedHero title={data.heroTitle} lead={data.lead} image={data.heroImage} alt={data.heroAlt} eyebrow="Services across KL & Selangor" compact />
  <section class="locked-directory" aria-labelledby="service-directory-title"><div class="locked-wrap">
    <p class="locked-eyebrow">Service directory</p><h2 id="service-directory-title">Choose the right team for your space</h2>
    <div class="locked-directory-grid">{cards.map((card: any) => <a class="locked-directory-card" href={`${base}${card.route}`}>
      {card.image ? <img src={`${base}${card.image}`} alt={card.alt} width="720" height="480" loading="lazy" /> : <span class="locked-card-mark" aria-hidden="true">RK</span>}
      <span class="locked-directory-copy"><strong>{card.title}</strong><span>{card.description}</span><small>View service <span aria-hidden="true">→</span></small></span>
    </a>)}</div>
  </div></section>
  <div class="source-locked-body locked-hub-source"><LockedContentSections sections={data.sections} toc={data.toc} resolveMedia={data.resolveMedia} variant="hub" /></div>
</article>
