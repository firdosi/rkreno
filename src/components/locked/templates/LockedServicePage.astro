---
import ServiceRecoveryRouter from '../../service-recovery/ServiceRecoveryRouter.astro';
import { serviceRecoveryModels } from '../../../data/service-recovery';
const { page, record } = Astro.props as any;
const model = serviceRecoveryModels[page.path];
if (!model) throw new Error(`Missing service recovery model for ${page.path}`);
const repairs: Record<string, string> = {
  '/about/': '/about-us/', '/tag/pemasangan-aircond/': '/upah-pasang-aircond-selangor-panduan-harga-pemasangan-2026/',
  '/tag/ceiling-works/': '/plaster-ceiling-contractor-kl/', '/tag/wiring/': '/electrical-services-selangor/', '/tag/guide/': '/blog/',
  '/tag/kuala-lumpur/': '/category/servis-pembersihan/', '/tag/aircond-maintenance/': '/servis-aircond-murah-kl-the-ultimate-2026-guide-to-a-colder-home/',
  '/tag/cleaning/': '/category/servis-pembersihan/', '/service/building-construction/': '/services/', '/service/architecture-design/': '/services/',
  '/service/flooring-roofing/': '/services/', '/service/general-contracting/': '/services/', '/service/repair-expand/': '/services/',
};
const sourceLinks = [...new Map((record.content.internalLinks || []).filter((link: any) => link.text).map((link: any) => {
  const path = repairs[new URL(link.href, 'https://rkrenosolution.com').pathname] || new URL(link.href, 'https://rkrenosolution.com').pathname;
  return [path, { href: path, label: link.text }];
})).values()].filter((link: any) => link.href !== page.path && !/^\/blog\/page\/(?:2|4)\/$/.test(link.href));
---
<ServiceRecoveryRouter model={{ ...model, title: record.content.h1, sourceLinks }} />
