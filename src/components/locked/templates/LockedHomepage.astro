---
import HomepageFeaturedSlider from '../../homepage-recovery/HomepageFeaturedSlider.astro';
import HomepageSlidersScript from '../../homepage-recovery/HomepageSlidersScript.astro';
import HomepageSourceForm from '../../homepage-recovery/HomepageSourceForm.astro';
import HomepageTestimonialSlider from '../../homepage-recovery/HomepageTestimonialSlider.astro';
import manifest from '../../../../config/homepage-exact-visible-content.json';
import imageMap from '../../../../config/homepage-image-map.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}${path}`;
const imageByPurpose = Object.fromEntries(imageMap.images.map((image) => [image.purpose, image]));
const { hero, introduction, featuredArticles, whyChoose, process, enquiry, testimonials, finalCta } = manifest;
---
<article class="source-locked-page recovery-page home-recovery" data-locked-template="homepage" data-homepage-exact>
  <section class="home-hero" data-home-section="hero">
    <div class="home-shell home-hero-grid">
      <div class="home-hero-copy">
        <p class="home-kicker">{hero.eyebrow}</p>
        <h1>{hero.h1}</h1>
        <p>{hero.paragraph}</p>
        <div class="home-actions">
          {hero.buttons.map((button, index) => <a class:list={["home-button", index ? "home-button-outline-dark" : "home-button-orange"]} href={href(button.href)}>{button.text} <span aria-hidden="true">→</span></a>)}
        </div>
        <p class="home-trust-line"><span aria-hidden="true">★★★★★</span>{hero.trustStatement}</p>
      </div>
      <img class="home-hero-image" data-image-purpose="hero-building" src={href(imageByPurpose['hero-building'].localPath)} alt={imageByPurpose['hero-building'].alt} width={imageByPurpose['hero-building'].width} height={imageByPurpose['hero-building'].height} fetchpriority="high" />
    </div>
  </section>

  <section class="home-intro home-section" data-home-section="introduction">
    <div class="home-shell home-intro-grid">
      <div class="home-intro-media">
        <img class="home-intro-main" data-image-purpose="introduction-worker" src={href(imageByPurpose['introduction-worker'].localPath)} alt={imageByPurpose['introduction-worker'].alt} width={imageByPurpose['introduction-worker'].width} height={imageByPurpose['introduction-worker'].height} loading="lazy" />
        <img class="home-intro-support" data-image-purpose="introduction-support" src={href(imageByPurpose['introduction-support'].localPath)} alt={imageByPurpose['introduction-support'].alt} width={imageByPurpose['introduction-support'].width} height={imageByPurpose['introduction-support'].height} loading="lazy" />
        <div class="home-experience"><strong>{introduction.experienceValue}</strong><span>{introduction.experienceLabel}</span></div>
      </div>
      <div class="home-copy-block">
        <p class="home-kicker">{introduction.eyebrow}</p>
        <h2>{introduction.heading}</h2>
        <p>{introduction.paragraph}</p>
        <div class="home-mini-benefits">
          {introduction.benefits.map((benefit, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{benefit.title}</h3><p>{benefit.description}</p></div></article>)}
        </div>
        <div class="home-inline-actions">
          <a class="home-button home-button-orange" href={href(introduction.button.href)}>{introduction.button.text} <span aria-hidden="true">→</span></a>
          <a class="home-phone" href={introduction.phoneHref}><small>{introduction.phonePrompt}</small><strong>{introduction.phone}</strong></a>
        </div>
      </div>
    </div>
  </section>

  <section class="home-featured home-section" data-home-section="featuredArticles" data-image-purpose="featured-background">
    <div class="home-shell">
      <div class="home-section-head home-section-head-inverse">
        <div><p class="home-kicker">{featuredArticles.eyebrow}</p><h2>{featuredArticles.heading}</h2></div>
        <a class="home-button home-button-orange" href={href(featuredArticles.button.href)}>{featuredArticles.button.text} <span aria-hidden="true">→</span></a>
      </div>
      <HomepageFeaturedSlider content={featuredArticles} />
    </div>
  </section>

  <section class="home-service home-section" data-home-section="whyChoose">
    <div class="home-shell home-service-grid">
      <div class="home-copy-block">
        <p class="home-kicker">{whyChoose.eyebrow}</p>
        <h2>{whyChoose.heading}</h2>
        <p>{whyChoose.paragraph}</p>
        <div class="home-stats">{whyChoose.statistics.map((stat) => <div><strong>{stat.value}</strong><span>{stat.label}</span></div>)}</div>
        <div class="home-actions">{whyChoose.buttons.map((button, index) => <a class:list={["home-button", index ? "home-button-outline-dark" : "home-button-orange"]} href={href(button.href)}>{button.text} <span aria-hidden="true">→</span></a>)}</div>
      </div>
      <img data-image-purpose="why-choose-building" src={href(imageByPurpose['why-choose-building'].localPath)} alt={imageByPurpose['why-choose-building'].alt} width={imageByPurpose['why-choose-building'].width} height={imageByPurpose['why-choose-building'].height} loading="lazy" />
    </div>
    <div class="home-shell home-benefit-grid">{whyChoose.benefits.map((benefit, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{benefit.title}</h3><p>{benefit.description}</p></article>)}</div>
  </section>

  <section class="home-process home-section" data-home-section="process">
    <div class="home-shell">
      <div class="home-section-head home-section-head-center"><div><p class="home-kicker">{process.eyebrow}</p><h2>{process.heading}</h2><p>{process.paragraph}</p></div></div>
      <div class="home-process-map">
        <div class="home-process-center"><strong>04</strong><span>{process.stepsLabel}</span></div>
        {process.steps.map((step, index) => <article class={`home-process-step home-process-step-${index + 1}`}><strong>{step.number}</strong><div><h3>{step.title}</h3><p>{step.description}</p></div></article>)}
      </div>
      <div class="home-process-action"><span>{process.prompt}</span><a class="home-button home-button-orange" href={href(process.button.href)}>{process.button.text} <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="home-enquiry home-section" data-home-section="enquiry" data-image-purpose="enquiry-building" style={`--home-enquiry-image:url('${href(imageByPurpose['enquiry-building'].localPath)}')`}>
    <div class="home-shell home-enquiry-grid"><HomepageSourceForm content={enquiry} /></div>
  </section>

  <section class="home-testimonials home-section" data-home-section="testimonials">
    <div class="home-shell home-testimonial-layout">
      <img data-image-purpose="testimonial-construction" src={href(imageByPurpose['testimonial-construction'].localPath)} alt={imageByPurpose['testimonial-construction'].alt} width={imageByPurpose['testimonial-construction'].width} height={imageByPurpose['testimonial-construction'].height} loading="lazy" />
      <div class="home-testimonial-content"><p class="home-kicker">{testimonials.eyebrow}</p><h2>{testimonials.heading}</h2><HomepageTestimonialSlider content={testimonials} /></div>
    </div>
  </section>

  <section class="home-final-cta" data-home-section="finalCta" data-image-purpose="final-cta-texture" style={`--home-final-texture:url('${href(imageByPurpose['final-cta-texture'].localPath)}')`}>
    <div class="home-shell home-final-grid">
      <img data-image-purpose="final-cta-worker" src={href(imageByPurpose['final-cta-worker'].localPath)} alt={imageByPurpose['final-cta-worker'].alt} width={imageByPurpose['final-cta-worker'].width} height={imageByPurpose['final-cta-worker'].height} loading="lazy" />
      <div><h2>{finalCta.heading}</h2><p>{finalCta.paragraph}</p><div class="home-actions">{finalCta.buttons.map((button, index) => <a class:list={["home-button", index ? "home-button-outline-light" : "home-button-orange"]} href={href(button.href)}>{button.text} <span aria-hidden="true">→</span></a>)}</div></div>
    </div>
  </section>
  <HomepageSlidersScript />
</article>
