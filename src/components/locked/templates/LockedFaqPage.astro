---
import LockedHero from '../LockedHero.astro';
import LockedContentSections from '../LockedContentSections.astro';
import { prepareLockedPage } from '../locked-page-data';
const { record, page } = Astro.props as any;
const data = prepareLockedPage(record, page);
---
<article class="source-locked-page locked-faq-page" data-locked-template="faq">
  <LockedHero title={data.heroTitle} lead={data.lead} image={data.heroImage} alt={data.heroAlt} eyebrow="Questions before your project" compact />
  <div class="source-locked-body locked-faq-body"><LockedContentSections sections={data.sections} toc={data.toc} resolveMedia={data.resolveMedia} variant="faq" /></div>
</article>
