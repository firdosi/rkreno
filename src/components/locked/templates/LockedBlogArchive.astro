---
import LockedHero from '../LockedHero.astro';
import LockedContentSections from '../LockedContentSections.astro';
import { cardFromRecord, prepareLockedPage, ARTICLE_ROUTES } from '../locked-page-data';
const { record, page, allRecords, pageByRoute } = Astro.props as any;
const data = prepareLockedPage(record, page);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const articles = allRecords.filter((item: any) => ARTICLE_ROUTES.has(item.route)).map((item: any) => cardFromRecord(item, pageByRoute));
const featured = articles[0];
---
<article class="source-locked-page locked-blog-archive" data-locked-template="blog-archive">
  <LockedHero title={data.heroTitle} lead={data.lead} image={featured?.image || data.heroImage} alt={featured?.alt || data.heroAlt} eyebrow="Renovation & property guides" compact />
  {featured && <section class="locked-featured-article"><div class="locked-wrap"><a href={`${base}${featured.route}`}>
    {featured.image && <img src={`${base}${featured.image}`} alt={featured.alt} width="960" height="640" />}
    <span><small>Latest guide</small><strong>{featured.title}</strong><span>{featured.description}</span><b>Read the guide →</b></span>
  </a></div></section>}
  <section class="locked-article-catalog" aria-labelledby="article-catalog-title"><div class="locked-wrap">
    <p class="locked-eyebrow">Knowledge centre</p><h2 id="article-catalog-title">Practical guides for better project decisions</h2>
    <div class="locked-article-grid">{articles.map((article: any) => <a class="locked-article-card" href={`${base}${article.route}`}>
      {article.image && <img src={`${base}${article.image}`} alt={article.alt} width="720" height="480" loading="lazy" />}
      <span><small>{article.category || 'RK Reno guide'}{article.date && ` · ${new Date(article.date).toLocaleDateString('en-MY', { year: 'numeric', month: 'short', day: 'numeric' })}`}</small><strong>{article.title}</strong><span>{article.description}</span><b>Read article →</b></span>
    </a>)}</div>
  </div></section>
  <div class="source-locked-body locked-blog-source"><LockedContentSections sections={data.sections} toc={data.toc} resolveMedia={data.resolveMedia} variant="blog" /></div>
</article>
