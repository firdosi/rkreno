---
import RecoveryHero from '../../core-recovery/RecoveryHero.astro';
import RecoverySectionHeading from '../../core-recovery/RecoverySectionHeading.astro';
import RecoveryArticleCard from '../../core-recovery/RecoveryArticleCard.astro';
import RecoveryCta from '../../core-recovery/RecoveryCta.astro';
import { coreMedia, relatedServiceLinks } from '../../../data/core-page-design';
import { blogPosts } from '../../../data/blog-posts';
const { record, allRecords, pageByRoute } = Astro.props as any;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const articles = blogPosts.map((post) => ({ route: post.route, title: post.title, category: post.category, date: post.published, description: post.excerpt, image: post.imagePath, alt: post.imageAlt }));
const [featured, ...rest] = articles;
---
<article class="source-locked-page recovery-page recovery-blog" data-locked-template="blog-archive">
  <RecoveryHero eyebrow="Renovation & property guides" title={record.content.h1} lead="Practical reading about renovation planning, aircond work, waterproofing, electrical services, ceilings and property care." image={coreMedia.contractor} alt="RK Reno contractor reviewing renovation work" compact />
  <section class="recovery-section recovery-blog-featured"><div class="recovery-wrap"><RecoverySectionHeading eyebrow="Latest guide" title="Start with the newest practical project guide" /> <RecoveryArticleCard article={featured} image={featured.image} featured /></div></section>
  <section class="recovery-section recovery-blog-catalog recovery-section-warm"><div class="recovery-wrap">
    <RecoverySectionHeading eyebrow="All guides" title="Research the work before requesting a quotation" lead="Browse all fourteen genuine migrated posts, ordered by publication date." />
    <div class="recovery-article-grid">{rest.map((article) => <RecoveryArticleCard article={article} image={article.image} />)}</div>
  </div></section>
  <nav class="recovery-section recovery-related-services" aria-label="Related services"><div class="recovery-wrap"><RecoverySectionHeading eyebrow="From guide to service" title="Explore the relevant service pages" /><div>{relatedServiceLinks.map(([href, label]) => <a href={`${base}${href}`}>{label}<span aria-hidden="true">→</span></a>)}</div></div></nav>
  <RecoveryCta title="Ready to discuss the actual property?" text="Articles provide general guidance. Share the site location, photos and required work for a project-specific discussion and quotation." />
</article>
