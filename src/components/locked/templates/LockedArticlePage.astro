---
import LockedHero from '../LockedHero.astro';
import LockedContentSections from '../LockedContentSections.astro';
import LockedToc from '../LockedToc.astro';
import { prepareLockedPage } from '../locked-page-data';
const { record, page, featuredImage = '', featuredAlt = '' } = Astro.props as any;
const data = prepareLockedPage(record, page, featuredImage, featuredAlt);
---
<article class="source-locked-page locked-article-page" data-locked-template="article">
  <LockedHero title={data.heroTitle} lead={data.lead} image={data.heroImage} alt={data.heroAlt} eyebrow={record.content.categories?.[0] || 'RK Reno guide'} dateLabel={data.dateLabel} published={data.published} />
  <div class="locked-article-shell locked-wrap">
    <aside class="locked-article-rail"><LockedToc toc={data.toc} /><a class="locked-rail-cta" href="https://wa.me/601111334496"><small>Planning related work?</small><strong>Ask RK Reno</strong></a></aside>
    <div class="source-locked-body locked-editorial-body"><LockedContentSections sections={data.sections} toc={data.toc} resolveMedia={data.resolveMedia} variant="article" /></div>
  </div>
  <aside class="locked-final-cta"><div class="locked-wrap"><div><p class="locked-eyebrow">From guide to project</p><h2>Get a site-specific quotation</h2></div><a class="locked-button locked-button-primary" href="https://wa.me/601111334496">WhatsApp RK Reno</a></div></aside>
</article>
