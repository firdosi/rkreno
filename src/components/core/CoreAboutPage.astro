---
import CorePageTitle from './CorePageTitle.astro';
import CoreFinalCta from './CoreFinalCta.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const leadershipImages = [
  ['/assets/media/Home-renovation-service-in-KL-422b205c.jpg', 'Home renovation service in Kuala Lumpur'],
  ['/assets/media/Office-renovation-service-in-Selangor-7928d19d.jpg', 'Office renovation service in Selangor'],
  ['/assets/media/Bathroom-waterproofing-service-in-KL-3293ca94.jpg', 'Bathroom waterproofing service in Kuala Lumpur'],
  ['/assets/media/Plaster-ceiling-and-aircond-installation-dd789b38.jpg', 'Plaster ceiling and aircond installation'],
];
---
<div class="core-page">
  <CorePageTitle title="About Us" description="Practical renovation and property-service support for customers in Kuala Lumpur and Selangor." />

  <section class="core-about-lead core-section">
    <div class="exact-wrap">
      <div class="core-about-visual">
        <img src={`${base}/assets/media/about2-2726a495.webp`} alt="RK Reno Solution renovation work" />
        <div><strong>15+</strong><span>Years of Experience</span></div>
      </div>
      <div>
        <p class="core-kicker">WHO ARE WE</p>
        <h2>Reliable Renovation Contractor in KL and Selangor</h2>
        <p>RK Reno Solution helps customers with home renovation, office renovation, waterproofing, plaster ceiling, aircond installation, cleaning services, and general property improvement work. We focus on clear planning, practical service advice, and neat finishing so every project is handled with care.</p>
        <ul>
          <li>Home and Office Renovation Services</li>
          <li>Waterproofing, Ceiling and Installation Work</li>
          <li>Clear Communication and Reliable Workmanship</li>
        </ul>
        <a class="core-button core-button-orange" href={`${base}/services/`}>Read More <span>→</span></a>
      </div>
    </div>
  </section>

  <section class="core-about-choice core-section">
    <div class="exact-wrap">
      <p class="core-kicker">WHY CHOOSE RK RENO SOLUTION</p>
      <h2>Every Renovation Decision Matters</h2>
      <p>Renovation work affects your comfort, budget, and property value. That is why our team takes time to understand your needs, check the site properly, and suggest practical solutions before starting the work.</p>
      <p>Planning renovation, repair, or installation work? Contact RK Reno Solution today for a free quotation. Contact us now today!</p>
      <a class="core-button core-button-light" href={`${base}/contact-us/`}>Get Free Quote <span>→</span></a>
    </div>
  </section>

  <section class="core-approach core-section">
    <div class="exact-wrap">
      <div>
        <p class="core-kicker">OUR APPROACH</p>
        <h2>Simple, Clear and Practical Renovation Support</h2>
        <p>Every project starts with understanding the customer’s space, budget, and service needs. Whether it is a small repair, a full renovation, waterproofing work, plaster ceiling, aircond installation, or cleaning service, we aim to provide clear advice and reliable execution.</p>
        <a class="core-button core-button-orange" href={`${base}/contact-us/`}>Contact Our Team <span>→</span></a>
      </div>
      <div class="core-approach-images">
        <img src={`${base}/assets/media/Renovation-planning-and-project-drawings-6cfdb2fc.jpg`} alt="Contractor inspecting renovation project" />
        <img src={`${base}/assets/media/Renovation-planning-and-project-drawings-1-ea76b170.jpg`} alt="Renovation planning and project drawings" />
      </div>
    </div>
  </section>

  <section class="core-leadership core-section">
    <div class="exact-wrap">
      <div class="core-heading"><p class="core-kicker">RK RENO SOLUTION</p><h2>Meet Our Leadership</h2><p>RK Reno Solution brings together practical renovation and property service experience to help customers complete work with less stress and better clarity.</p></div>
      <div class="core-operator"><p>Operator</p><h3>Rao Israr</h3><span>RK Reno Solution</span></div>
      <div class="core-leadership-images">
        {leadershipImages.map(([image, alt]) => <img src={`${base}${image}`} alt={alt} loading="lazy" />)}
      </div>
    </div>
  </section>

  <section class="core-areas core-section">
    <div class="exact-wrap">
      <img src={`${base}/assets/media/Service-areas-in-KL-and-Selangor-0f0a8548.jpg`} alt="Service areas in Kuala Lumpur and Selangor" />
      <div><p class="core-kicker">WHERE WE WORK</p><h2>Serving Kuala Lumpur, Selangor and Nearby Areas</h2><p>RK Reno Solution provides renovation, repair, waterproofing, plaster ceiling, aircond installation, and cleaning services across Kuala Lumpur, Selangor, and nearby locations. Contact us to check service availability for your area.</p><a class="core-button core-button-orange" href={`${base}/contact-us/`}>Check Availability <span>→</span></a></div>
    </div>
  </section>
  <CoreFinalCta />
</div>
