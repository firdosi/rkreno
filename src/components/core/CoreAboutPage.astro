---
import CorePageTitle from './CorePageTitle.astro';
import CoreFinalCta from './CoreFinalCta.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const values = [
  ['Site-aware planning', 'We first consider the property condition, access, requested outcome and any building rules that affect the work.'],
  ['Defined work scope', 'Quotations should make materials, quantities, exclusions, disposal and possible additional work easier to understand.'],
  ['Practical communication', 'Customers can share photos, measurements and priorities before a site review and stay informed about agreed next steps.'],
  ['Care for the property', 'Protection, safe access, debris handling and preparation for following trades are part of planning the work.'],
];
const services = [
  ['/house-renovation-in-kuala-lumpur/', 'Home Renovation', '/assets/media/Home-renovation-service-in-KL-422b205c.jpg'],
  ['/office-renovation-in-kuala-lumpur/', 'Office Renovation', '/assets/media/Office-renovation-service-in-Selangor-7928d19d.jpg'],
  ['/waterproofing-contractor-kuala-lumpur/', 'Waterproofing', '/assets/media/Bathroom-waterproofing-service-in-KL-3293ca94.jpg'],
  ['/aircond-installation-kl/', 'Aircond Installation', '/assets/media/owner/rk-reno-wall-mounted-aircond-unit-960.webp'],
];
---
<div class="core-page p21-about">
  <CorePageTitle title="About Us" description="Meet RK Reno Solution and learn how we plan renovation and property-service work in Kuala Lumpur and Selangor." />
  <section class="core-section p21-about-opening"><div class="exact-wrap p2-split">
    <figure><img src={`${base}/assets/media/about2-2726a495.webp`} alt="RK Reno Solution renovation and property-service planning" width="566" height="704" /></figure>
    <div><p class="core-kicker">WHO WE ARE</p><h2>A Practical Renovation and Property-Service Team</h2><p>RK Reno Solution supports homeowners, landlords and businesses with renovation, aircond, electrical, waterproofing, ceiling, cleaning and interior demolition enquiries.</p><p>Our approach is to understand the actual site, define the requested work and explain relevant access or approval considerations before the scope is confirmed.</p><a class="core-button core-button-orange" href={`${base}/contact-us/`}>Discuss Your Property</a></div>
  </div></section>
  <section class="p21-about-benefits"><div class="exact-wrap">{values.map(([title, text]) => <article><span aria-hidden="true">◇</span><h2>{title}</h2><p>{text}</p></article>)}</div></section>
  <section class="core-section p21-about-approach"><div class="exact-wrap p2-split">
    <div><p class="core-kicker">OUR APPROACH</p><h2>From Enquiry to a Clearer Work Scope</h2><ol class="p2-number-list"><li>Share your location, property type, photos and required work.</li><li>Review site condition, measurements, access and relevant building rules.</li><li>Confirm quotation inclusions, exclusions, materials and work sequence.</li><li>Coordinate the agreed work and preparation for any following trade.</li></ol></div>
    <img src={`${base}/assets/media/Renovation-planning-and-project-drawings-6cfdb2fc.jpg`} alt="Contractor reviewing renovation work and project requirements" width="1000" height="700" loading="lazy" />
  </div></section>
  <section class="core-section p21-about-services"><div class="exact-wrap">
    <div class="core-heading"><p class="core-kicker">WHAT WE DO</p><h2>Explore Our Main Property Services</h2><p>Each service page explains the work, pricing context where published, common questions and the details needed for an enquiry.</p></div>
    <div class="p21-about-service-grid">{services.map(([href, title, image]) => <article><a href={`${base}${href}`}><img src={`${base}${image}`} alt={`${title} service illustration`} width="700" height="500" loading="lazy" /></a><h3><a href={`${base}${href}`}>{title}</a></h3></article>)}</div>
  </div></section>
  <section class="core-section p21-about-areas"><div class="exact-wrap">
    <img src={`${base}/assets/media/Service-areas-in-KL-and-Selangor-0f0a8548.jpg`} alt="Service coverage across Kuala Lumpur and Selangor" width="1000" height="700" loading="lazy" />
    <div><p class="core-kicker">WHERE WE WORK</p><h2>Kuala Lumpur, Selangor and Nearby Areas</h2><p>Availability depends on the service, exact address and work scope. Send the project location through WhatsApp so the team can check it before arranging the next step.</p><div class="core-button-row"><a class="core-button core-button-orange" href="https://wa.me/601111334496">Check Your Area</a><a class="core-button core-button-outline" href={`${base}/services/`}>View Services</a></div></div>
  </div></section>
  <CoreFinalCta />
</div>
