---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="core-final-cta">
  <div class="exact-wrap">
    <img src={`${base}/assets/media/home7-img7-f8f5cbc2.webp`} alt="" width="441" height="546" loading="lazy" />
    <div>
      <h2>Ready to Work Together?</h2>
      <p>Whether you need renovation, waterproofing, plaster ceiling, aircond installation, electrical work, or cleaning services, contact RK Reno Solution and share your property details.</p>
      <div class="core-button-row">
        <a class="core-button core-button-light" href={`${base}/contact-us/`}>Get a Quote <span>→</span></a>
        <a class="core-button core-button-outline" href="tel:+601111334496">Call Us <span>→</span></a>
      </div>
    </div>
  </div>
</section>
