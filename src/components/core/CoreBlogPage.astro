---
import CorePageTitle from './CorePageTitle.astro';
import CoreFinalCta from './CoreFinalCta.astro';
import { retainedArticleCatalog } from '@data/retained-article-catalog';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const serviceLinks = [
  ['/house-renovation-in-kuala-lumpur/', 'House renovation'],
  ['/servis-aircond-murah-kl/', 'Aircond servicing'],
  ['/waterproofing-contractor-kuala-lumpur/', 'Waterproofing'],
  ['/servis-cuci-rumah-kl/', 'Cleaning'],
];
---
<div class="core-page p21-blog">
  <CorePageTitle title="Blog" description="Practical guides for renovation, aircond, electrical, waterproofing, ceiling and cleaning work." />
  <section class="core-section p2-blog-intro"><div class="exact-wrap p2-split"><div><p class="core-kicker">PLANNING GUIDES</p><h2>Research the Work Before Requesting a Quote</h2><p>Browse all 14 retained guides for scope, pricing context, access considerations and questions to ask before property work begins.</p></div><nav aria-label="Related services">{serviceLinks.map(([href, label]) => <a href={`${base}${href}`}>{label}</a>)}</nav></div></section>
  <section class="core-section p21-blog-section"><div class="exact-wrap"><div class="p2-blog-grid">
    {retainedArticleCatalog.map((article) => <article>
      <a class="p21-blog-image" href={`${base}${article.route}`}><img src={`${base}${article.image}`} srcset={article.imageSrcSet?.map(({src,width}) => `${base}${src} ${width}w`).join(', ')} sizes="(max-width:760px) 100vw, 380px" alt={article.imageAlt} width={article.imageWidth} height={article.imageHeight} loading="lazy" /></a>
      <div><p class="core-blog-meta"><span>{article.category}</span> · <time datetime={article.published}>{new Date(`${article.published}T00:00:00`).toLocaleDateString('en-MY', { day: 'numeric', month: 'short', year: 'numeric' })}</time></p><h2><a href={`${base}${article.route}`}>{article.title}</a></h2><p>{article.summary}</p><a class="core-read-link" href={`${base}${article.route}`}>Read guide <span aria-hidden="true">→</span></a></div>
    </article>)}
  </div></div></section>
  <CoreFinalCta />
</div>
