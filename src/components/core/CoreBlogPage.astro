---
import CorePageTitle from './CorePageTitle.astro';
import { retainedArticleCatalog } from '@data/retained-article-catalog';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const archives = [
  ['/category/commercial/', 'Commercial'],
  ['/category/hvac-guides/', 'HVAC Guides'],
  ['/category/maintenance/', 'Maintenance'],
  ['/category/renovation/', 'Renovation'],
  ['/category/servis-pembersihan/', 'Servis Pembersihan'],
  ['/category/technical-guides/', 'Technical Guides'],
  ['/tag/interior-finishing/', 'Interior Finishing'],
  ['/tag/office-fit-out/', 'Office Fit-Out'],
  ['/tag/waterproofing/', 'Waterproofing'],
];
---
<div class="core-page p21-blog">
  <CorePageTitle title="Blog" description="Practical guides for renovation, aircond, electrical, waterproofing, ceiling and cleaning work." />

  <section class="core-section p21-blog-section">
    <div class="exact-wrap p21-blog-layout">
      <div class="p21-blog-list core-blog-grid">
        {retainedArticleCatalog.map((article) => (
          <article>
            <a class="p21-blog-image" href={`${base}${article.route}`}>
              <img
                src={`${base}${article.image}`}
                srcset={article.imageSrcSet?.map(({src,width})=>`${base}${src} ${width}w`).join(', ')}
                sizes="(max-width:760px) 100vw, 320px"
                alt={article.imageAlt}
                width={article.imageWidth}
                height={article.imageHeight}
                loading="lazy"
              />
            </a>
            <div>
              <p class="core-blog-meta"><span>{article.category}</span> · <time datetime={article.published}>{article.published}</time></p>
              <h2><a href={`${base}${article.route}`}>{article.title}</a></h2>
              <p>{article.summary}</p>
              <a class="core-read-link" href={`${base}${article.route}`}>Read More →</a>
            </div>
          </article>
        ))}
        <nav class="core-pagination" aria-label="Blog pagination"><span aria-current="page">1</span><a href="#top">2</a><a href="#top">Next Page →</a></nav>
      </div>

      <aside class="p21-blog-sidebar">
        <form role="search" aria-label="Blog search">
          <label for="blog-search">Search posts</label>
          <div><input id="blog-search" type="search" disabled /><button type="button" disabled>Search</button></div>
        </form>
        <nav class="core-blog-topics" aria-label="Blog categories">
          <h2>Categories</h2>
          {archives.map(([href, label]) => <a href={`${base}${href}`}>{label}</a>)}
        </nav>
        <div>
          <h2>Service Links</h2>
          <a href={`${base}/services/`}>All Services</a>
          <a href={`${base}/contact-us/`}>Contact RK Reno</a>
          <a href="https://wa.me/601111334496">WhatsApp</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="p21-blog-cta">
    <div class="exact-wrap"><p>Need help connecting a guide to your property?</p><a class="core-button core-button-orange" href={`${base}/contact-us/`}>Get a Quote →</a></div>
  </section>
</div>
