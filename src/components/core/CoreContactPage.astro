---
import CorePageTitle from './CorePageTitle.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="core-page p21-contact">
  <CorePageTitle title="Contact Us" description="Contact RK Reno Solution about renovation, repair, installation and cleaning work." />

  <section class="core-section p21-contact-main">
    <div class="exact-wrap p21-contact-grid">
      <div class="p21-contact-details">
        <p class="core-kicker">GET IN TOUCH</p>
        <h2>Have a question? Please contact us using the customer support channels below.</h2>
        <dl>
          <div><dt>Address</dt><dd>4-2, Jalan 3/50C, Setapak, 53000 Kuala Lumpur</dd></div>
          <div><dt>Phone number</dt><dd><a href="tel:+601111334496">+60 11 1133 4496</a></dd></div>
          <div><dt>WhatsApp</dt><dd><a href="https://wa.me/601111334496">Send a WhatsApp message</a></dd></div>
          <div><dt>Email</dt><dd><a href="mailto:rkrenosolution@gmail.com">rkrenosolution@gmail.com</a></dd></div>
        </dl>
        <nav aria-label="Direct contact options">
          <a href="tel:+601111334496">Call</a>
          <a href="https://wa.me/601111334496">WhatsApp</a>
          <a href="mailto:rkrenosolution@gmail.com">Email</a>
        </nav>
      </div>

      <div class="p21-contact-form-wrap">
        <h2>Send Your Enquiry</h2>
        <p>Please submit all general enquiries in the contact form below and we look forward to hearing from you soon.</p>
        <form class="core-contact-form" data-configured="false" aria-describedby="core-form-note">
          <label>Full Name*<input type="text" name="name" disabled /></label>
          <label>Email Address*<input type="email" name="email" disabled /></label>
          <label>Phone Number*<input type="tel" name="phone" disabled /></label>
          <label>Your services*
            <select name="service" disabled><option>What are your needs?</option><option>Renovation</option><option>Aircond</option><option>Waterproofing</option><option>Plaster Ceiling</option><option>Electrical</option><option>Cleaning</option></select>
          </label>
          <label class="core-full-field">Message<textarea name="message" rows="7" disabled></textarea></label>
          <label class="core-consent core-full-field"><input type="checkbox" disabled /><span>I agree that RK Reno Solution may use these details to respond to my enquiry.</span></label>
          <button class="core-button core-button-orange core-full-field" type="button" disabled>Send Message →</button>
          <p id="core-form-note" class="core-form-note core-full-field">Online submission is disabled on GitHub Pages. Please call or use WhatsApp.</p>
        </form>
      </div>
    </div>
  </section>

  <section class="core-section p21-contact-followup">
    <div class="exact-wrap">
      <div>
        <p class="core-kicker">DIRECT CONTACT</p>
        <h2>Share the Property and Work Details</h2>
        <p>Include the property location, relevant photos, approximate measurements where available, and the renovation, repair or installation work you want reviewed.</p>
        <div class="core-button-row">
          <a class="core-button core-button-orange" href="https://wa.me/601111334496">Open WhatsApp →</a>
          <a class="core-button core-button-outline" href={`${base}/services/`}>View Services →</a>
        </div>
      </div>
      <img src={`${base}/assets/media/ct-08-a16e9952.webp`} alt="Building and construction visual" width="526" height="556" loading="lazy" />
    </div>
  </section>
</div>
