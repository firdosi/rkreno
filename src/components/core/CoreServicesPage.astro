---
import CorePageTitle from './CorePageTitle.astro';
import CoreFinalCta from './CoreFinalCta.astro';
import CoreServiceDirectory from './CoreServiceDirectory.astro';
import { homeServiceCards } from '@data/homepage-exact';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const features = [
  ['⌖', 'Site Checking', 'We review your space and service requirement before starting, so the work can be planned properly.'],
  ['⚒', 'Workmanship', 'We focus on clean finishing, practical materials, and service work that fits your property needs.'],
  ['↗', 'Clear Communication', 'We keep customers updated with simple guidance, clear next steps, and easy communication throughout the work.'],
];
---
<div class="core-page">
  <CorePageTitle title="Services" description="Renovation, repair and installation services for properties in Kuala Lumpur and Selangor." />

  <section class="core-section core-intro">
    <div class="exact-wrap core-intro-grid">
      <p class="core-kicker">RK RENO SOLUTION</p>
      <h2>Property Services Done With Care and Clear Planning</h2>
      <p>Whether you need renovation, repair, ceiling work, leakage solutions, aircond installation, or cleaning service, our team starts by understanding your space, checking the work needed, and guiding you with the right service approach.</p>
    </div>
  </section>

  <section class="core-features">
    <div class="exact-wrap">
      {features.map(([icon, title, text]) => (
        <article><span>{icon}</span><h2>{title}</h2><p>{text}</p><a href={`${base}/contact-us/`}>View More →</a></article>
      ))}
    </div>
  </section>

  <section class="core-section core-services-list">
    <div class="exact-wrap">
      <div class="core-heading">
        <p class="core-kicker">OUR SERVICES</p>
        <h2>Renovation, Repair &amp; Installation Services in KL and Selangor</h2>
        <p>RK Reno Solution helps homeowners, office owners, landlords, and businesses improve their spaces with reliable property services.</p>
      </div>
      <CoreServiceDirectory />
      <p class="core-service-directory-note">
        Planning work outside central Kuala Lumpur? See our
        <a href={`${base}/home-renovation-contractor-in-subang-jaya/`}>Subang Jaya renovation service</a>,
        or review the <a href={`${base}/faq/`}>frequently asked questions</a> before requesting a quote.
      </p>
    </div>
  </section>

  <section class="core-section core-dark-articles">
    <div class="exact-wrap">
      <div class="core-heading">
        <p class="core-kicker">LATEST SERVICE GUIDES</p>
        <h2>Practical Information for Your Property Work</h2>
      </div>
      <div class="core-article-grid">
        {homeServiceCards.map((card) => (
          <article>
            <a href={`${base}${card.href}`}><img src={`${base}${card.image}`} alt="" loading="lazy" /></a>
            <div><p>{card.date} · {card.category}</p><h3><a href={`${base}${card.href}`}>{card.title}</a></h3><a href={`${base}${card.href}`}>Read More →</a></div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <CoreFinalCta />
</div>
