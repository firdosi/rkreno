---
import CorePageTitle from './CorePageTitle.astro';
import CoreFinalCta from './CoreFinalCta.astro';
import { coreServices } from '@data/core-pages';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const groups = [
  { title: 'Renovation and strip-out', routes: ['/service/building-renovation/', '/house-renovation-in-kuala-lumpur/', '/house-renovation-in-selangor/', '/office-renovation-in-kuala-lumpur/', '/demolition-contractor-kl-selangor/'] },
  { title: 'Aircond and electrical', routes: ['/servis-aircond-murah-kl/', '/aircond-installation-kl/', '/upah-pasang-aircond-selangor/', '/electrical-services-selangor/'] },
  { title: 'Waterproofing, ceiling and cleaning', routes: ['/waterproofing-contractor-kuala-lumpur/', '/plaster-ceiling-contractor-kl/', '/servis-cuci-rumah-kl/'] },
];
---
<div class="core-page p21-services">
  <CorePageTitle title="Services" description="Renovation, aircond, electrical, waterproofing, ceiling, cleaning and demolition services in Kuala Lumpur and Selangor." />
  <section class="core-section p2-service-hub-intro">
    <div class="exact-wrap p2-split">
      <div><p class="core-kicker">RK RENO SOLUTION</p><h2>Property Services Planned Around the Actual Site</h2><p>Choose the service that matches your property and work scope. We review location, access, existing condition and the requested outcome before confirming a quotation.</p></div>
      <ul class="p2-check-list"><li>Home, office and commercial-property enquiries</li><li>Clear inclusions, exclusions and site requirements</li><li>Service availability across Kuala Lumpur and Selangor</li></ul>
    </div>
  </section>
  {groups.map((group) => (
    <section class="core-section p2-service-group"><div class="exact-wrap">
      <h2>{group.title}</h2>
      <div class="p2-service-grid">
        {coreServices.filter((service) => group.routes.includes(service.href)).map((service) => (
          <article><a href={`${base}${service.href}`}><img src={`${base}${service.image}`} alt={`${service.title} service illustration`} width="720" height="480" loading="lazy" /></a><div><h3><a href={`${base}${service.href}`}>{service.title}</a></h3><p>{service.text}</p><a class="core-read-link" href={`${base}${service.href}`}>View service details <span aria-hidden="true">→</span></a></div></article>
        ))}
      </div>
    </div></section>
  ))}
  <section class="core-section p2-service-planning"><div class="exact-wrap p2-split">
    <img src={`${base}/assets/media/Renovation-planning-and-project-drawings-1-ea76b170.jpg`} alt="Renovation drawings used to plan a property-service scope" width="800" height="500" loading="lazy" />
    <div><p class="core-kicker">BEFORE REQUESTING A QUOTE</p><h2>Share Enough Detail for a Useful Scope Review</h2><p>Send the property location, photos or video, approximate measurements, preferred work and any building access rules. For renovation and demolition, also identify which areas must remain protected.</p><div class="core-button-row"><a class="core-button core-button-orange" href="https://wa.me/601111334496">Send Details on WhatsApp</a><a class="core-button core-button-outline" href={`${base}/contact-us/`}>Contact Us</a></div></div>
  </div></section>
  <CoreFinalCta />
</div>
