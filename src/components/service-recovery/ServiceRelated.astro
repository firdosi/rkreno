---
import ServiceSectionHeading from './ServiceSectionHeading.astro';
import type { RelatedService } from '../../data/service-recovery';
const { items } = Astro.props as { items: RelatedService[] };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="service-recovery-section service-recovery-related"><div class="service-recovery-wrap">
  <ServiceSectionHeading eyebrow="Related work" title="Coordinate the connected service scope" />
  <div class="service-recovery-related-grid">{items.map((item) => <a href={`${base}${item.href}`}><img src={item.image} alt="" width="420" height="240" loading="lazy" /><div><h3>{item.title}</h3><p>{item.text}</p><span>View service →</span></div></a>)}</div>
</div></section>
