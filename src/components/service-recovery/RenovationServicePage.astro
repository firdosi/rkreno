---
import ServiceHero from './ServiceHero.astro'; import ServiceOverview from './ServiceOverview.astro'; import ServiceSectionHeading from './ServiceSectionHeading.astro'; import ServiceItemGrid from './ServiceItemGrid.astro'; import ServicePricing from './ServicePricing.astro'; import ServiceLocations from './ServiceLocations.astro'; import ServiceFaqs from './ServiceFaqs.astro'; import ServiceRelated from './ServiceRelated.astro'; import ServiceSourceLinks from './ServiceSourceLinks.astro'; import ServiceFinalCta from './ServiceFinalCta.astro';
import type { ServiceRecoveryModel } from '../../data/service-recovery';
const { model } = Astro.props as { model: ServiceRecoveryModel };
---
<article class="service-recovery-page service-family-renovation" data-service-family="renovation" data-locked-template="service">
  <ServiceHero model={model} /><ServiceOverview items={model.overview} />
  <section class="service-recovery-section"><div class="service-recovery-wrap"><ServiceSectionHeading eyebrow="Property and project types" title={model.typesTitle} /><ServiceItemGrid items={model.types} /></div></section>
  <section class="service-recovery-section service-recovery-split service-recovery-section-warm"><div class="service-recovery-wrap"><div><ServiceSectionHeading eyebrow="Build the work list" title={model.scopeTitle} /><ServiceItemGrid items={model.scope} /></div><img src={model.bodyImages[0].src} alt={model.bodyImages[0].alt} width="620" height="560" loading="lazy" /></div></section>
  <ServicePricing model={model} />
  <section class="service-recovery-section service-recovery-factor-layout"><div class="service-recovery-wrap"><ServiceSectionHeading eyebrow="Cost planning" title={model.quotationTitle} /><ServiceItemGrid items={model.quotationFactors} /></div></section>
  <section class="service-recovery-section service-recovery-section-dark"><div class="service-recovery-wrap"><ServiceSectionHeading eyebrow="Planning and inspection" title="From priorities to an agreed handover" /><ServiceItemGrid items={model.process} numbered /></div></section>
  <ServiceLocations areas={model.areas} /><ServiceFaqs faqs={model.faqs} /><ServiceRelated items={model.related} /><ServiceSourceLinks links={model.sourceLinks} /><ServiceFinalCta title={model.finalTitle} text={model.finalText} />
</article>
