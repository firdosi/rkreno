---
import ArticleSection from './ArticleSection.astro';
const { model } = Astro.props as any;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<article class:list={['article-recovery-page', `article-recovery-${model.family}`]} data-locked-template="article" data-article-recovery={model.family}>
  <header class="article-recovery-hero">
    <div class="article-recovery-hero-copy">
      <p class="article-recovery-kicker">{model.category}</p>
      <h1>{model.title}</h1>
      {model.lead && <p class="article-recovery-lead">{model.lead}</p>}
      {model.dateLabel && <time datetime={model.published}>{model.dateLabel}</time>}
    </div>
    {model.heroImage && <figure><img src={`${base}${model.heroImage}`} alt={model.heroAlt} width="1200" height="800" fetchpriority="high" /></figure>}
  </header>

  <div class="article-recovery-reading">
    {model.takeaways.length > 0 && <aside class="article-recovery-takeaways" aria-label="Guide overview">
      <strong>In this guide</strong>
      <ul>{model.takeaways.map((item: string) => <li>{item}</li>)}</ul>
    </aside>}
    <nav class="article-recovery-toc" aria-label="Table of contents">
      <details open>
        <summary>Table of contents</summary>
        <ol>{model.toc.map((item: any) => <li><a href={`#${item.id}`}>{item.text}</a></li>)}</ol>
      </details>
    </nav>
    <div class="article-recovery-stream">
      {model.sections.map((section: any) => <ArticleSection section={section} resolveMedia={model.resolveMedia} />)}
    </div>
  </div>

  <aside class="article-recovery-service-cta">
    <div><p>Related RK Reno service</p><h2>{model.serviceLabel}</h2></div>
    <a href={`${base}${model.serviceHref}`}>View service details</a>
  </aside>

  <nav class="article-recovery-related" aria-label="Related guides">
    <p>Continue reading</p><h2>Related practical guides</h2>
    <div>{model.related.map((item: any) => <a href={`${base}${item.href}`}><small>{item.category}</small><strong>{item.title}</strong><span>Read guide →</span></a>)}</div>
  </nav>

  <aside class="article-recovery-final-cta">
    <div><p>Discuss the actual property</p><h2>Request a site-specific quotation</h2></div>
    <a href="https://wa.me/601111334496">WhatsApp RK Reno</a>
  </aside>
</article>
