---
import { homeSteps } from '@data/homepage-exact';
import { retainedArticleCatalog } from '@data/retained-article-catalog';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const guideRoutes = new Set([
  '/upah-pasang-aircond-selangor-panduan-harga-pemasangan-2026/',
  '/house-renovation-in-kuala-lumpur-the-ultimate-planning-cost-guide-2026/',
  '/waterproofing-contractor-kuala-lumpur-the-complete-guide-to-stopping-leaks-2026/',
]);
const guides = retainedArticleCatalog.filter((article) => guideRoutes.has(article.route));
---
<section class="exact-process exact-section">
  <div class="exact-wrap">
    <div class="exact-section-title"><p class="exact-eyebrow">OUR PROCESS</p><h2>How We Handle Your Project</h2><p>Use this process for aircond, renovation, demolition and supporting property-service enquiries.</p></div>
    <div class="exact-process-map"><div class="exact-process-center"><strong>04</strong><span>STEPS</span></div>{homeSteps.map((step, index) => <article class={`step-${index + 1}`}><strong>{step.number}</strong><div><h3>{step.title}</h3><p>{step.text}</p></div></article>)}</div>
    <div class="exact-process-cta"><p>Ready to discuss the property?</p><a href={`${base}/contact-us/`}>Request a quotation <span>→</span></a></div>
  </div>
</section>

<section class="exact-section prompt2-areas">
  <div class="exact-wrap prompt2-split">
    <div><p class="exact-eyebrow">SERVICE AREAS</p><h2>Kuala Lumpur and Selangor Enquiries</h2><p>Share the exact address, property type and required work. Availability, building access and the need for a site inspection are confirmed before scheduling.</p><a class="exact-text-link" href={`${base}/contact-us/`}>Check your location <span>→</span></a></div>
    <img src={`${base}/assets/media/Service-areas-in-KL-and-Selangor-0f0a8548.jpg`} alt="Service areas across Kuala Lumpur and Selangor" width="1000" height="700" loading="lazy" />
  </div>
</section>

<section class="exact-enquiry exact-section">
  <div class="exact-wrap exact-enquiry-grid">
    <div aria-hidden="true"></div>
    <form class="exact-contact-form" aria-label="Enquiry form preview" data-preview-form data-configured="false" novalidate>
      <p class="exact-eyebrow">CONTACT US</p><h2>Share Your Project Details</h2>
      <div class="exact-field-grid">
        <label class="exact-field-label"><span>Full name *</span><input type="text" name="name" autocomplete="name" required /></label>
        <label class="exact-field-label"><span>Phone number *</span><input type="tel" name="phone" autocomplete="tel" inputmode="tel" required /></label>
        <label class="exact-field-label"><span>Email address</span><input type="email" name="email" autocomplete="email" /></label>
        <label class="exact-field-label"><span>Property location *</span><input type="text" name="location" autocomplete="street-address" required /></label>
        <label class="exact-field-label"><span>Service needed *</span><select name="service" required><option value="">Choose a service</option><option>Aircond servicing or installation</option><option>House or office renovation</option><option>Demolition or strip-out</option><option>Electrical, waterproofing or ceiling</option><option>Cleaning</option></select></label>
        <label class="exact-field-label"><span>Property type</span><input type="text" name="propertyType" /></label>
      </div>
      <label class="exact-field-label exact-field-label--details"><span>Required work, current condition and preferred timing *</span><textarea name="projectDetails" required></textarea></label>
      <label><input type="checkbox" name="consent" required /> <span>I agree that RK Reno Solution may use these details to respond to my enquiry.</span></label>
      <button type="submit">Preview enquiry <span>→</span></button><p class="form-status" data-form-status role="status" aria-live="polite">Preview only: no message will be sent from GitHub Pages.</p>
    </form>
  </div>
</section>

<section class="exact-section prompt2-guides">
  <div class="exact-wrap"><div class="exact-section-title"><p class="exact-eyebrow">PLANNING GUIDES</p><h2>Helpful Information Before You Request a Quote</h2></div><div class="prompt2-guide-grid">{guides.map((guide) => <article><img src={`${base}${guide.image}`} alt={guide.imageAlt} width={guide.imageWidth} height={guide.imageHeight} loading="lazy" /><p>{guide.category} · <time datetime={guide.published}>{guide.published}</time></p><h3><a href={`${base}${guide.route}`}>{guide.title}</a></h3><p>{guide.summary}</p></article>)}</div></div>
</section>

<section class="exact-final-cta"><div class="exact-wrap exact-final-inner"><img src={`${base}/assets/media/home7-img7-f8f5cbc2.webp`} alt="Renovation planning illustration" width="441" height="546" loading="lazy" /><div><h2>Need Aircond, Renovation or Demolition Work?</h2><p>Send your location, photos and required scope for an initial discussion. Final work and pricing depend on the confirmed site requirements.</p><div class="exact-actions"><a class="exact-button exact-button-white" href="https://wa.me/601111334496">WhatsApp RK Reno <span>→</span></a><a class="exact-button exact-button-outline" href="tel:+601111334496">Call +60 11 1133 4496</a></div></div></div></section>
