---
import { homeBenefits } from '@data/homepage-exact';
import { coreServices } from '@data/core-pages';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const priorityServices = coreServices.filter((service) => [
  '/servis-aircond-murah-kl/', '/house-renovation-in-kuala-lumpur/',
  '/demolition-contractor-kl-selangor/', '/electrical-services-selangor/',
  '/waterproofing-contractor-kuala-lumpur/', '/servis-cuci-rumah-kl/',
].includes(service.href));
---
<section class="exact-hero">
  <div class="exact-wrap exact-hero-inner">
    <div class="exact-hero-copy">
      <p class="exact-eyebrow">RK Reno Solution</p>
      <h1>Reliable Renovation Contractor in KL &amp; Selangor</h1>
      <p>Plan aircond work, renovation, demolition, waterproofing, electrical, ceiling and cleaning services with one clear first step: share the property location, photos and required scope.</p>
      <div class="exact-actions">
        <a class="exact-button exact-button-orange" href={`${base}/services/`}>Explore Services <span>→</span></a>
        <a class="exact-button exact-button-dark" href="https://wa.me/601111334496">WhatsApp a Quote <span>→</span></a>
      </div>
      <div class="exact-trust"><a href="tel:+601111334496">Call +60 11 1133 4496</a><span>·</span><a href={`${base}/contact-us/`}>Send project details</a></div>
    </div>
  </div>
</section>

<section class="exact-about exact-section">
  <div class="exact-wrap exact-about-grid">
    <div class="exact-about-images">
      <img class="exact-about-main" src={`${base}/assets/media/RK-Reno-Solution-contractor-reviewing-renovation-projec-1fc54dc9.jpg`} alt="Contractor reviewing renovation requirements" width="896" height="1200" />
      <img class="exact-about-small" src={`${base}/assets/media/owner/rk-reno-aircond-indoor-unit-service-access-960.webp`} alt="Owner-supplied aircond service access image" width="960" height="720" />
    </div>
    <div class="exact-about-copy">
      <p class="exact-eyebrow">ABOUT RK RENO SOLUTION</p>
      <h2>Practical Property Work Starts with a Clear Scope</h2>
      <p>RK Reno Solution helps homeowners and businesses discuss renovation, repair, installation and maintenance work in Kuala Lumpur and Selangor. Site conditions, access, materials and the agreed quotation determine the final work.</p>
      <ul class="p2-check-list"><li>Share the exact property location and service required</li><li>Provide photos, measurements and relevant access details</li><li>Review the quotation scope before work begins</li></ul>
      <div class="exact-about-features">
        <article><span>01</span><div><h3>Site-aware planning</h3><p>Photos and measurements support an initial review, while complex work may require a site inspection.</p></div></article>
        <article><span>02</span><div><h3>Clear communication</h3><p>The quotation should identify included work, materials, exclusions and possible additional charges.</p></div></article>
      </div>
      <div class="exact-about-bottom"><a class="exact-button exact-button-orange" href={`${base}/about-us/`}>About Our Approach <span>→</span></a><p class="home-contact-line">Questions? <a href="tel:+601111334496">Call RK Reno</a></p></div>
    </div>
  </div>
</section>

<section class="exact-services exact-section">
  <div class="exact-wrap">
    <div class="exact-heading-row"><div><p class="exact-eyebrow">PRIORITY SERVICES</p><h2>Aircond, Renovation and Demolition Support</h2></div><a class="exact-button exact-button-outline" href={`${base}/services/`}>All Services <span>→</span></a></div>
    <div class="exact-service-cards">
      {priorityServices.map((service) => (
        <article>
          <a class="exact-card-image" href={`${base}${service.href}`}><img src={`${base}${service.image}`} alt={`${service.title} service illustration`} width="900" height="650" loading="lazy" /></a>
          <div class="exact-card-body"><p class="exact-card-category">KL &amp; Selangor enquiries</p><h3><a href={`${base}${service.href}`}>{service.title}</a></h3><p>{service.text}</p><a class="exact-read-more" href={`${base}${service.href}`}>Explore service <span>→</span></a></div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="exact-why exact-section">
  <div class="exact-wrap exact-why-grid">
    <div class="exact-why-copy">
      <p class="exact-eyebrow">WHY CHOOSE RK RENO SOLUTION</p>
      <h2>Useful Information Before Work Begins</h2>
      <p>A practical enquiry starts with the property location, required work and current condition. Those details help identify access needs, measurements, likely materials and whether an inspection is needed.</p>
      <div class="exact-stats prompt2-value-points"><div><strong>Site review</strong><span>Confirm the condition and requested scope</span></div><div><strong>Clear quotation</strong><span>Review inclusions and exclusions</span></div><div><strong>KL &amp; Selangor</strong><span>Confirm availability for your address</span></div></div>
      <div class="exact-actions"><a class="exact-button exact-button-orange" href={`${base}/contact-us/`}>Request a Discussion <span>→</span></a><a class="exact-text-link" href="https://wa.me/601111334496">WhatsApp photos <span>→</span></a></div>
    </div>
    <div class="exact-why-image"><img src={`${base}/assets/media/Modern-building-renovation-and-property-improvement-b1ec6039.jpg`} alt="Property renovation and improvement planning" width="1200" height="896" loading="lazy" /></div>
  </div>
  <div class="exact-wrap exact-benefits">{homeBenefits.map((benefit) => <article><span>{benefit.icon}</span><div><h3>{benefit.title}</h3><p>{benefit.text}</p></div></article>)}</div>
</section>
