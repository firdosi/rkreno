---
import Breadcrumbs from './Breadcrumbs.astro';
import type { BatchArticle } from '@data/batch2-articles';
const { article, path } = Astro.props as { article: BatchArticle; path: string };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<article class="article-page">
  <header class="article-hero">
    <div class="wrap article-hero__inner">
      <p class="eyebrow">{article.category}</p>
      <h1>{article.title}</h1>
      <p class="batch-lead">{article.summary}</p>
      <p class="article-meta">
        Published <time datetime={article.published}>{article.published}</time>
        {article.modified !== article.published && <> · Updated <time datetime={article.modified}>{article.modified}</time></>}
      </p>
    </div>
  </header>
  <Breadcrumbs path={path} title={article.title} />
  <div class="wrap article-layout section-space">
    <div class="article-body">
      <figure><img src={`${base}${article.image}`} alt={article.imageAlt} width="1100" height="620" /></figure>
      <p class="article-intro">{article.summary}</p>
      {article.sections.map((section) => <section>
        <h2>{section.title}</h2>
        {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        {section.subheading && <h3>{section.subheading}</h3>}
        {section.points && <ul>{section.points.map((point) => <li>{point}</li>)}</ul>}
        {section.table && (
          <div class="responsive-table" tabindex="0" role="region" aria-label={`${section.title} table`}>
            <table>
              <thead><tr>{section.table.headers.map((header) => <th scope="col">{header}</th>)}</tr></thead>
              <tbody>{section.table.rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
            </table>
          </div>
        )}
      </section>)}
      <aside class="article-callout">
        <p class="eyebrow">Related service</p>
        <h2>Arrange a site-based discussion</h2>
        <p>Use the guide to prepare questions, then confirm the actual scope from the property.</p>
        <a class="button" href={`${base}${article.serviceHref}`}>{article.serviceLabel}</a>
      </aside>
      <nav class="article-related" aria-label="Related reading">
        <h2>Related reading</h2>
        {article.related?.map((item) => <a href={`${base}${item.href}`}>{item.label} →</a>)}
        <a href={`${base}/blog/`}>Browse all property-service guides →</a>
      </nav>
    </div>
  </div>
</article>
