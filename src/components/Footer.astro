---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname.replace(base, '') || '/';
const isHome = currentPath === '/';
const year = new Date().getFullYear();
---

{!isHome && (
  <section class="rk-footer-cta">
      <div>
        <h2>Ready to work together?</h2>
        <p>Whether you have a project in mind and you’re looking for a reliable construction partner<br />or you’re looking to take the next step in your career, we want to hear from you!</p>
        <nav aria-label="Work with RK Reno">
          <a href={`${base}/contact-us/`}>Get a Quote</a>
          <a href="https://wa.me/601111334496">WhatsApp us</a>
        </nav>
      </div>
  </section>
)}
<footer class:list={['rk-footer', isHome ? 'rk-footer--home' : 'rk-footer--inner']} data-shared-footer>
  <div class="rk-footer__main">
    <div class="rk-footer__brand">
      <a href={`${base}/`} aria-label="RK Reno Solution home">
        <img src={`${base}/assets/media/RK-Reno-Solutions-Logo-942f64bb.png`} alt="" width="1575" height="483" />
      </a>
      <h2>Building a Better Future – Innovative, Sustainable, Reliable.</h2>
    </div>
    <div class="rk-footer__address">
      <h2>COMPANY ADDRESS</h2>
      <p><strong>Mail to:</strong> <a href="mailto:rkrenosolution@gmail.com">rkrenosolution@gmail.com</a></p>
      <p><strong>Phone:</strong> <a href="tel:+601111334496">+60 11 1133 4496</a></p>
      <p><strong>Address:</strong> <a class="rk-address-link" href="https://share.google/ZxiE3enIVqmg6LSSm">4-2, Jalan 3/50C, Setapak, 53000 Kuala Lumpur<br /><span class="rk-location">Our Locations</span></a></p>
    </div>
  </div>
  <div class="rk-footer__bottom">
    <p>Copyright © {year} RK Reno Solution. All rights reserved.</p>
    <a href={`${base}/sitemap.xml`}>Sitemap</a>
  </div>
</footer>
