---
import Breadcrumbs from './Breadcrumbs.astro';
import { retainedArticleCatalog } from '@data/retained-article-catalog';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="batch-page">
  <section class="article-hero"><div class="wrap article-hero__inner">
    <p class="eyebrow">RK Reno Solution guides</p><h1>Renovation & Property Service Blog</h1>
    <p class="batch-lead">Browse retained practical guides for renovation, aircond, electrical, waterproofing, ceiling and cleaning work.</p>
  </div></section>
  <Breadcrumbs path="/blog/" title="Blog" />
  <section class="section-space"><div class="wrap">
    <div class="archive-grid">
      {retainedArticleCatalog.map((article) => <article class="service-card">
        <p class="eyebrow">{article.category}</p><h2>{article.title}</h2>
        <p>{article.summary}</p>
        <a href={`${base}${article.route}`}>Read guide <span aria-hidden="true">→</span></a>
      </article>)}
    </div>
  </div></section>
</div>
