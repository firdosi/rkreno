---
import Breadcrumbs from './Breadcrumbs.astro';
import { retainedArticleCatalog } from '@data/retained-article-catalog';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="batch-page">
  <section class="article-hero"><div class="wrap article-hero__inner">
    <p class="eyebrow">RK Reno Solution guides</p><h1>Blog</h1>
    <p class="batch-lead">Browse retained practical guides for renovation, aircond, electrical, waterproofing, ceiling and cleaning work.</p>
  </div></section>
  <Breadcrumbs path="/blog/" title="Blog" />
  <section class="section-space"><div class="wrap">
    <div class="archive-grid taxonomy-grid">
      {retainedArticleCatalog.map((article) => <article class="taxonomy-card">
        <a class="taxonomy-card__image" href={`${base}${article.route}`}>
          <img
            src={`${base}${article.image}`}
            srcset={article.imageSrcSet?.map(({ src, width }) => `${base}${src} ${width}w`).join(', ')}
            sizes="(max-width: 760px) 100vw, 32vw"
            alt={article.imageAlt}
            width={article.imageWidth ?? 640}
            height={article.imageHeight ?? 360}
            loading="lazy"
            decoding="async"
          />
        </a>
        <div class="taxonomy-card__body">
          <p class="eyebrow">{article.category}</p>
          <h2><a href={`${base}${article.route}`}>{article.title}</a></h2>
          <p>{article.summary}</p>
          <p class="article-meta"><time datetime={article.published}>{article.published}</time></p>
          <a class="text-link taxonomy-card__link" href={`${base}${article.route}`}>Read guide <span aria-hidden="true">→</span></a>
        </div>
      </article>)}
    </div>
  </div></section>
</div>
