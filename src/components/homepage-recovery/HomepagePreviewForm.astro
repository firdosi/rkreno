<form class="home-preview-form" aria-labelledby="home-preview-title" data-disabled-enquiry-form>
  <div class="home-preview-heading">
    <p class="home-kicker">Project enquiry preview</p>
    <h2 id="home-preview-title">Get in touch with us</h2>
    <p>This staging form is a visual preview and cannot send or store information. Use the contact options below to reach RK Reno.</p>
  </div>
  <div class="home-preview-fields">
    <label><span>Name</span><input type="text" autocomplete="name" placeholder="Your name" disabled /></label>
    <label><span>Phone number</span><input type="tel" autocomplete="tel" placeholder="+60" disabled /></label>
    <label><span>Email</span><input type="email" autocomplete="email" placeholder="you@example.com" disabled /></label>
    <label><span>Company name</span><input type="text" autocomplete="organization" placeholder="Optional" disabled /></label>
    <label><span>Project type</span><select disabled><option>Choose a service</option></select></label>
    <label><span>Budget</span><input type="text" placeholder="Estimated budget" disabled /></label>
    <label class="home-preview-wide"><span>Write message</span><textarea rows="4" placeholder="Location, property type and required work" disabled></textarea></label>
    <label class="home-preview-consent"><input type="checkbox" disabled /><span>I understand this preview does not submit or store information.</span></label>
    <button type="submit" disabled>Preview only — message not sent</button>
  </div>
</form>
