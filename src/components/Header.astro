---
import { primaryNavigation, services } from '@data/navigation';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (href: string) => `${base}${href}`;
const currentPath = Astro.url.pathname.replace(base, '') || '/';
const isCurrent = (href: string) => href !== '#' && (
  href === '/' ? currentPath === '/' : currentPath.startsWith(href)
);
const secondary = primaryNavigation.filter(({ label }) => ['Blog', 'About Us', 'Contact Us'].includes(label));
---

<header class="rk-header" data-shared-header data-state="initial">
  <div class="rk-header__desktop">
    <div class="rk-topbar">
      <div class="rk-topbar__inner">
        <p>Reliable Renovation, Repair &amp; Installation Services in KL and Selangor</p>
        <div class="rk-topbar__contacts">
          <a href="tel:+601111334496"><span aria-hidden="true">☎</span> +60 11 1133 4496</a>
          <a href="mailto:rkrenosolution@gmail.com"><span aria-hidden="true">✉</span> rkrenosolution@gmail.com</a>
          <a href="https://maps.google.com/?q=4-2%2C+Jalan+3%2F50C%2C+Setapak%2C+53000+Kuala+Lumpur"><span aria-hidden="true">●</span> 4-2, Jalan 3/50C, Setapak, 53000 Kuala Lumpur</a>
          <span class="rk-language" aria-label="Current language: English">🇬🇧 English <span aria-hidden="true">⌄</span></span>
        </div>
      </div>
    </div>
    <div class="rk-navbar">
      <a class="rk-brand" href={link('/')} aria-label="RK Reno Solution home">
        <img src={`${base}/assets/media/RK-Reno-Solutions-Logo-942f64bb.png`} alt="RK Reno Solution" width="1575" height="483" />
      </a>
      <nav class="rk-nav" aria-label="Primary navigation">
        <a class:list={['rk-nav__link', { 'is-current': isCurrent('/') }]} href={link('/')} aria-current={isCurrent('/') ? 'page' : undefined}>Home</a>
        <div class="rk-nav__services">
          <button class="rk-nav__link rk-nav__toggle" type="button" aria-expanded="false" aria-controls="rk-services-menu">
            Services <span aria-hidden="true">⌄</span>
          </button>
          <ul class="rk-dropdown" id="rk-services-menu">
            {services.map((item) => <li><a href={link(item.href)}>{item.label}</a></li>)}
          </ul>
        </div>
        {secondary.map((item) => (
          <a class:list={['rk-nav__link', { 'is-current': isCurrent(item.href) }]} href={link(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
      <button class="rk-search" type="button" aria-label="Search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 5 5"></path></svg>
      </button>
      <a class="rk-cart" href="#" aria-label="Cart, 0 items">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2 12h11l2-8H7"></path><circle cx="9" cy="20" r="1"></circle><circle cx="18" cy="20" r="1"></circle></svg>
        <span>0</span>
      </a>
      <a class="rk-header-cta" href={link('/contact-us/')}>Get A Quote <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <div class="rk-mobilebar">
    <a class="rk-mobilebar__brand" href={link('/')} aria-label="RK Reno Solution home">
      <img src={`${base}/assets/media/RK-Reno-Solutions-Logo-942f64bb.png`} alt="RK Reno Solution" width="1575" height="483" />
    </a>
    <button class="rk-menu-button" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="rk-mobile-drawer">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="rk-drawer" id="rk-mobile-drawer" aria-hidden="true" inert>
    <div class="rk-drawer__scroll">
      <button class="rk-drawer__close" type="button" aria-label="Close navigation">×</button>
      <a class="rk-drawer__brand" href={link('/')} aria-label="RK Reno Solution home">
        <img src={`${base}/assets/media/RK-Reno-Solutions-Logo-942f64bb.png`} alt="RK Reno Solution" width="1575" height="483" />
      </a>
      <form class="rk-drawer__search" role="search" data-local-search>
        <input type="search" name="search" placeholder="Search..." aria-label="Search" />
        <button type="submit" aria-label="Submit search">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 5 5"></path></svg>
        </button>
      </form>
      <nav aria-label="Mobile navigation">
        <ul class="rk-mobile-nav">
          <li><a class:list={{ 'is-current': isCurrent('/') }} href={link('/')} aria-current={isCurrent('/') ? 'page' : undefined}>Home</a></li>
          <li>
            <div class="rk-mobile-nav__row">
              <span>Services</span>
              <button class="rk-submenu-button" type="button" aria-label="Toggle Services submenu" aria-expanded="false" aria-controls="rk-mobile-services">⌄</button>
            </div>
            <ul class="rk-mobile-submenu" id="rk-mobile-services">
              {services.map((item) => <li><a href={link(item.href)}>{item.label}</a></li>)}
            </ul>
          </li>
          {secondary.map((item) => (
            <li><a class:list={{ 'is-current': isCurrent(item.href) }} href={link(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
  <button class="rk-drawer-backdrop" type="button" aria-label="Close navigation" tabindex="-1"></button>
</header>
