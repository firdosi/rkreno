---
import { primaryNavigation, services } from '@data/navigation';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (href: string) => `${base}${href}`;
const currentPath = Astro.url.pathname.replace(base, '') || '/';
const isHome = currentPath === '/';
const isCurrent = (href: string) => href !== '#' && (
  href === '/' ? currentPath === '/' : currentPath.startsWith(href)
);
const secondary = primaryNavigation.filter(({ label }) => ['Blog', 'About Us', 'Contact Us'].includes(label));
---

<header class:list={['rk-header', isHome ? 'rk-header--home' : 'rk-header--inner']} data-shared-header data-state="initial">
  <div class="rk-header__desktop">
    <div class="rk-topbar">
      <div class="rk-topbar__inner">
        <p>Reliable Renovation, Repair &amp; Installation Services in KL and Selangor</p>
        <div class="rk-topbar__contacts">
          <a href="tel:+601111334496"><span aria-hidden="true"><i class="fas fa-phone-alt"></i></span>+60 11 1133 4496</a>
          <a href="mailto:rkrenosolution@gmail.com"><span aria-hidden="true"><i class="fas fa-envelope"></i></span>rkrenosolution@gmail.com</a>
          <a href="#"><span aria-hidden="true"><i class="fas fa-map-marker-alt"></i></span>4-2, Jalan 3/50C, Setapak, 53000 Kuala Lumpur</a>
          <span class="rk-language-current" aria-hidden="true"><img src={`${base}/assets/media/shared-language-flag.jpg`} alt="" />English</span>
          <a class="rk-language" href="#" aria-label="English">English</a>
          <a class="rk-language rk-language--secondary" href="#" aria-label="Korean">Korean</a>
        </div>
      </div>
    </div>
    <div class="rk-navbar">
      <a class="rk-brand" href={link('/')} aria-label="RK Reno Solution home">
        <img src={`${base}/assets/media/RK-Reno-Solutions-Logo-942f64bb.png`} alt="" width="1575" height="483" />
      </a>
      <nav class="rk-nav" aria-label="Primary navigation">
        <a class:list={['rk-nav__link', { 'is-current': isCurrent('/') }]} href={link('/')} aria-current={isCurrent('/') ? 'page' : undefined}><span class="rk-menu-text">Home</span></a>
        <div class="rk-nav__services">
          <button class="rk-nav__link rk-nav__toggle" type="button" aria-expanded="false" aria-controls="rk-services-menu">
            <span class="rk-menu-text">Services <span class="rk-menu-indicator" aria-hidden="true">⌄</span></span>
          </button>
          <ul class="rk-dropdown" id="rk-services-menu">
            {services.map((item) => <li><a href={link(item.href)}><span class="rk-menu-text">{item.label}</span></a></li>)}
          </ul>
        </div>
        {secondary.map((item) => (
          <a class:list={['rk-nav__link', { 'is-current': isCurrent(item.href) }]} href={link(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}><span class="rk-menu-text">{item.label}</span></a>
        ))}
      </nav>
      <button class="rk-search" type="button" aria-label="Search">
        <svg viewBox="0 0 21 21" aria-hidden="true"><path d="M9.02 0a9.02 9.02 0 0 1 6.93 14.79L21 19.84 19.84 21l-5.05-5.05A9.02 9.02 0 1 1 9.02 0Zm0 16.4a7.38 7.38 0 1 0 0-14.76 7.38 7.38 0 0 0 0 14.76Z"></path></svg>
      </button>
      <a class="rk-cart" href="#" aria-label="Cart, 0 items">
        <svg viewBox="0 0 21 21" aria-hidden="true"><path d="M18.75 15H5.25a.75.75 0 0 1-.75-.63L3 5.38a.75.75 0 0 1 .75-.88h16.5a.75.75 0 0 1 .74.87l-1.5 9a.75.75 0 0 1-.74.63ZM5.92 13.5h12.2L19.37 6H4.64l1.28 7.5ZM3.1 5.91l-.73-4.41H0V0h3a.75.75 0 0 1 .75.63l.84 5.02-1.49.26ZM19.5 18H5.62a.75.75 0 0 1-.74-.66l-.46-3.75 1.5-.18.37 3.09H19.5V18ZM6.38 21a1.12 1.12 0 1 0 0-2.25 1.12 1.12 0 0 0 0 2.25Zm12 0a1.12 1.12 0 1 0 0-2.25 1.12 1.12 0 0 0 0 2.25Z"></path></svg>
        <span>0</span>
      </a>
      <a class="rk-header-cta" href={link('/contact-us/')}>Get&nbsp;A&nbsp;Quote <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <div class="rk-mobilebar">
    <a class="rk-mobilebar__brand" href={link('/')} aria-label="RK Reno Solution home">
      <img src={`${base}/assets/media/RK-Reno-Solutions-Logo-942f64bb.png`} alt="" width="1575" height="483" />
    </a>
    <button class="rk-menu-button" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="rk-mobile-drawer">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="rk-drawer" id="rk-mobile-drawer" aria-hidden="true" inert>
    <div class="rk-drawer__scroll">
      <button class="rk-drawer__close" type="button" aria-label="Close navigation">×</button>
      <a class="rk-drawer__brand" href={link('/')} aria-label="RK Reno Solution home">
        <img src={`${base}/assets/media/RK-Reno-Solutions-Logo-942f64bb.png`} alt="" width="1575" height="483" />
      </a>
      <form class="rk-drawer__search" role="search" data-local-search>
        <input type="search" name="search" placeholder="Search..." aria-label="Search" />
        <button type="submit" aria-label="Submit search">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 5 5"></path></svg>
        </button>
      </form>
      <nav aria-label="Mobile navigation">
        <ul class="rk-mobile-nav">
          <li><a class:list={{ 'is-current': isCurrent('/') }} href={link('/')} aria-current={isCurrent('/') ? 'page' : undefined}><span>Home</span></a></li>
          <li>
            <div class="rk-mobile-nav__row">
              <a href="#"><span>Services</span></a>
              <button class="rk-submenu-button" type="button" aria-label="Toggle Services submenu" aria-expanded="false" aria-controls="rk-mobile-services">⌄</button>
            </div>
            <ul class="rk-mobile-submenu" id="rk-mobile-services">
              {services.map((item) => <li><a href={link(item.href)}><span>{item.label}</span></a></li>)}
            </ul>
          </li>
          {secondary.map((item) => (
            <li><a class:list={{ 'is-current': isCurrent(item.href) }} href={link(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}><span>{item.label}</span></a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
  <button class="rk-drawer-backdrop" type="button" aria-label="Close navigation" tabindex="-1"></button>
</header>
