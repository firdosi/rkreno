---
import { primaryNavigation, services } from '@data/navigation';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (href: string) => `${base}${href}`;
---

<header class="site-header">
  <div class="topbar">
    <div class="wrap topbar-inner">
      <div class="topbar-links">
        <a href="tel:+601111334496">+60 11 1133 4496</a>
        <a href="mailto:rkrenosolution@gmail.com">rkrenosolution@gmail.com</a>
        <span>4-2, Jalan 3/50C, Setapak, 53000 Kuala Lumpur</span>
      </div>
      <p>Renovation, repair and installation services in KL and Selangor</p>
    </div>
  </div>
  <div class="wrap nav-row">
    <a class="brand" href={link('/')} aria-label="RK Reno Solution home">
      <img src={`${base}/assets/media/RK-Reno-Solutions-Logo-942f64bb.png`} alt="RK Reno Solution" />
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href={link('/')}>Home</a>
      <details class="services-menu">
        <summary>Services</summary>
        <div class="dropdown">
          {services.map((item) => <a href={link(item.href)}>{item.label}</a>)}
        </div>
      </details>
      {primaryNavigation.filter((item) => ['Blog', 'About Us', 'Contact Us'].includes(item.label))
        .map((item) => <a href={link(item.href)}>{item.label}</a>)}
    </nav>
    <a class="button nav-quote" href={link('/contact-us/')}>Get a Quote</a>
    <details class="mobile-menu">
      <summary aria-label="Open navigation"><span></span><span></span><span></span></summary>
      <nav aria-label="Mobile navigation">
        {primaryNavigation.map((item) => <a href={link(item.href)}>{item.label}</a>)}
        <p>More services</p>
        {services.map((item) => <a href={link(item.href)}>{item.label}</a>)}
      </nav>
    </details>
  </div>
</header>
