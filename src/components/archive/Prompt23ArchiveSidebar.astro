---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const archives = [
  ['Commercial', '/category/commercial/'], ['Aircond', '/category/hvac-guides/'], ['Maintenance', '/category/maintenance/'],
  ['Renovation', '/category/renovation/'], ['Cleaning', '/category/servis-pembersihan/'], ['Technical', '/category/technical-guides/'],
  ['Interior finishing', '/tag/interior-finishing/'], ['Office fit-out', '/tag/office-fit-out/'], ['Waterproofing', '/tag/waterproofing/'],
];
---
<aside class="p23-archive-sidebar" aria-label="Guide collections">
  <section class="p3-archive-help"><p class="core-kicker">NEED SITE ADVICE?</p><h2>Use a Guide, Then Confirm the Scope</h2><p>Articles provide planning context. Send the actual property details before work or pricing is confirmed.</p><a class="core-button" href="https://wa.me/601111334496">WhatsApp RK Reno</a></section>
  <section><h2>GUIDE COLLECTIONS</h2><nav>{archives.map(([label, href]) => <a href={`${base}${href}`}>{label}</a>)}</nav></section>
</aside>
