---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const categories = [
  ['Commercial', '/category/commercial/'],
  ['HVAC Guides', '/category/hvac-guides/'],
  ['Interior Design', '/category/interior-design/'],
  ['Maintenance', '/category/maintenance/'],
  ['Renovation', '/category/renovation/'],
  ['Servis Pembersihan', '/category/servis-pembersihan/'],
  ['Technical Guides', '/category/technical-guides/'],
];
const tags = [
  ['Aircond Maintenance', '/tag/aircond-maintenance/'],
  ['Ceiling Works', '/tag/ceiling-works/'],
  ['Cleaning', '/tag/cleaning/'],
  ['Guide', '/tag/guide/'],
  ['Interior Finishing', '/tag/interior-finishing/'],
  ['Kuala Lumpur', '/tag/kuala-lumpur/'],
  ['Office Fit-Out', '/tag/office-fit-out/'],
  ['Pemasangan Aircond', '/tag/pemasangan-aircond/'],
  ['Waterproofing', '/tag/waterproofing/'],
  ['Wiring', '/tag/wiring/'],
];
const retained = new Set([
  '/category/commercial/', '/category/hvac-guides/', '/category/maintenance/',
  '/category/renovation/', '/category/servis-pembersihan/', '/category/technical-guides/',
  '/tag/interior-finishing/', '/tag/office-fit-out/', '/tag/waterproofing/',
]);
const sourceHref = (href: string) => retained.has(href) ? `${base}${href}` : `https://rkrenosolution.com${href}`;
---
<aside class="p23-archive-sidebar" aria-label="Archive navigation">
  <form role="search" data-preview-search>
    <label for="archive-search">Search</label>
    <div><input id="archive-search" type="search" placeholder="Search..." /><button type="submit">⌕</button></div>
    <small data-search-status role="status"></small>
  </form>
  <section><h2>CATEGORIES</h2><nav>{categories.map(([label, href]) => <a href={sourceHref(href)}>{label}</a>)}</nav></section>
  <section><h2>TAGS</h2><nav class="wp-tag-cloud">{tags.map(([label, href]) => <a href={sourceHref(href)}>{label}</a>)}</nav></section>
</aside>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-preview-search]').forEach((form) => form.addEventListener('submit', (event) => {
    event.preventDefault();
    const status = form.querySelector<HTMLElement>('[data-search-status]');
    if (status) status.textContent = 'Search is unavailable on this static preview.';
  }));
</script>
