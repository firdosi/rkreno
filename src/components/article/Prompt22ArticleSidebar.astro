---
interface Props { route: string; serviceHref?: string; serviceLabel?: string; related?: { href: string; label: string }[]; }
const { route, serviceHref, serviceLabel, related = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const themeLinks: Record<string, [string, string][]> = {
  aircond: [['/servis-aircond-murah-kl/', 'Aircond servicing'], ['/aircond-installation-kl/', 'Installation in Kuala Lumpur'], ['/upah-pasang-aircond-selangor/', 'Installation in Selangor']],
  renovation: [['/house-renovation-in-kuala-lumpur/', 'House renovation KL'], ['/house-renovation-in-selangor/', 'House renovation Selangor'], ['/office-renovation-in-kuala-lumpur/', 'Office renovation'], ['/service/building-renovation/', 'Building renovation'], ['/demolition-contractor-kl-selangor/', 'Interior demolition']],
  waterproofing: [['/waterproofing-contractor-kuala-lumpur/', 'Waterproofing service'], ['/plaster-ceiling-contractor-kl/', 'Plaster ceiling service']],
  cleaning: [['/servis-cuci-rumah-kl/', 'House cleaning service'], ['/services/', 'All property services']],
  electrical: [['/electrical-services-selangor/', 'Electrical services'], ['/house-renovation-in-selangor/', 'House renovation Selangor']],
};
const theme = /aircond/.test(route) ? 'aircond' : /cleaning|cuci/.test(route) ? 'cleaning' : /waterproof|injection/.test(route) ? 'waterproofing' : /electrical/.test(route) ? 'electrical' : 'renovation';
const links = [...(serviceHref ? [[serviceHref, serviceLabel || 'Related service'] as [string,string]] : []), ...themeLinks[theme], ...related.map((item) => [item.href, item.label] as [string,string])]
  .filter(([href], index, all) => all.findIndex(([candidate]) => candidate === href) === index).slice(0, 6);
---
<aside class="p22-article-sidebar" aria-label="Article resources">
  <section class="p3-sidebar-contact"><p class="core-kicker">PLAN THE NEXT STEP</p><h2>Discuss the Actual Site</h2><p>Send the location, photos, measurements and requested work before relying on a guide price.</p><a class="core-button" href="https://wa.me/601111334496">WhatsApp RK Reno</a><a href="tel:+601111334496">Call +60 11 1133 4496</a></section>
  <section class="p22-sidebar-widget"><h2>RELATED SERVICES</h2><nav>{links.map(([href, label]) => <a href={`${base}${href}`}>{label} <span aria-hidden="true">→</span></a>)}</nav></section>
  <section class="p22-sidebar-widget"><h2>MORE GUIDES</h2><nav><a href={`${base}/blog/`}>All planning guides</a><a href={`${base}/faq/`}>Service FAQs</a><a href={`${base}/contact-us/`}>Contact details</a></nav></section>
</aside>
