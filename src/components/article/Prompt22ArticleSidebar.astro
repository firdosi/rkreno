---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const categories = [
  ['Commercial', '/category/commercial/'],
  ['HVAC Guides', '/category/hvac-guides/'],
  ['Interior Design', '/category/interior-design/'],
  ['Maintenance', '/category/maintenance/'],
  ['Renovation', '/category/renovation/'],
  ['Servis Pembersihan', '/category/servis-pembersihan/'],
  ['Technical Guides', '/category/technical-guides/'],
];
const tags = [
  ['Aircond Maintenance', '/tag/aircond-maintenance/'],
  ['Interior Finishing', '/tag/interior-finishing/'],
  ['Office Fit-Out', '/tag/office-fit-out/'],
  ['Waterproofing', '/tag/waterproofing/'],
];
const sourceHref = (href: string) =>
  ['/category/interior-design/', '/tag/aircond-maintenance/'].includes(href)
    ? `https://rkrenosolution.com${href}`
    : `${base}${href}`;
---
<aside class="p22-article-sidebar" aria-label="Article sidebar">
  <form class="wp-sidebar-search" role="search" data-preview-search>
    <label><span class="sr-only">Search</span><input type="search" placeholder="Search..." /></label>
    <button type="submit" aria-label="Search">⌕</button>
    <p data-search-status role="status"></p>
  </form>
  <section class="p22-sidebar-widget"><h2>CATEGORIES</h2>{categories.map(([label, href]) => <a href={sourceHref(href)}>{label}</a>)}</section>
  <section class="p22-sidebar-widget"><h2>TAGS</h2><div class="wp-tag-cloud">{tags.map(([label, href]) => <a href={sourceHref(href)}>{label}</a>)}</div></section>
</aside>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-preview-search]').forEach((form) => form.addEventListener('submit', (event) => {
    event.preventDefault();
    const status = form.querySelector<HTMLElement>('[data-search-status]');
    if (status) status.textContent = 'Search is unavailable on this static preview.';
  }));
</script>
