---
import { retainedArticleCatalog } from '@data/retained-article-catalog';

const { serviceHref, serviceLabel, related = [] } = Astro.props as {
  serviceHref: string;
  serviceLabel: string;
  related?: { href: string; label: string }[];
};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const recent = retainedArticleCatalog.slice(0, 5);
---
<aside class="p22-article-sidebar" aria-label="Article sidebar">
  <section class="p22-sidebar-quote">
    <p>Planning work at your property?</p>
    <h2>Request a clear scope and quotation</h2>
    <span>Send the location, photos, measurements and work required before confirming the next step.</span>
    <a class="core-button" href="https://wa.me/601111334496">WhatsApp RK Reno <span>→</span></a>
  </section>
  <section class="p22-sidebar-widget">
    <h2>Related service</h2>
    <a href={`${base}${serviceHref}`}>{serviceLabel} <span>→</span></a>
    {related.map((item) => <a href={`${base}${item.href}`}>{item.label} <span>→</span></a>)}
  </section>
  <section class="p22-sidebar-widget">
    <h2>Recent guides</h2>
    {recent.map((item) => <a href={`${base}${item.route}`}>{item.title}</a>)}
  </section>
  <section class="p22-sidebar-widget">
    <h2>Search</h2>
    <label><span class="sr-only">Search articles</span><input type="search" placeholder="Search…" disabled /></label>
    <button type="button" disabled>Search</button>
  </section>
</aside>
