---
import CorePageTitle from './core/CorePageTitle.astro';
import Prompt23ArchiveSidebar from './archive/Prompt23ArchiveSidebar.astro';
import type { RetainedArticle } from '@data/retained-article-catalog';

interface Archive {
  type: string;
  title: string;
  description: string;
  introduction: string;
  serviceHref: string;
  serviceLabel: string;
}

const { archive, articles, sourceH1 } = Astro.props as {
  archive: Archive;
  articles: RetainedArticle[];
  sourceH1?: string;
};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="archive-exact-page">
  <CorePageTitle title={sourceH1 || archive.title} description={archive.introduction} />

  <section class="archive-exact-section">
    <div class="exact-wrap p23-archive-layout">
      <div>
        <header class="p23-archive-intro">
          <p>{archive.type} archive · retained guides</p>
          <h2>Latest articles</h2>
          <span>{archive.description}</span>
        </header>
        <div class="p23-archive-list">
          {articles.map((article) => (
            <article class="p23-archive-entry">
              <p>{article.category}</p>
              <h2><a href={`${base}${article.route}`}>{article.title}</a></h2>
              <span>{article.summary}</span>
              <time datetime={article.published}>{article.published}</time>
              <a class="p23-read-more" href={`${base}${article.route}`}>Read more →</a>
            </article>
          ))}
        </div>
      </div>
      <Prompt23ArchiveSidebar
        serviceHref={archive.serviceHref}
        serviceLabel={archive.serviceLabel}
      />
    </div>
  </section>

  <section class="archive-exact-cta">
    <div class="exact-wrap">
      <div>
        <p>Plan the next step</p>
        <h2>Connect the guide to the actual property</h2>
        <span>Use these articles to prepare questions, then confirm the scope from the site and requested work.</span>
      </div>
      <nav aria-label="Archive next steps">
        <a class="core-button" href={`${base}${archive.serviceHref}`}>{archive.serviceLabel}</a>
        <a href={`${base}/blog/`}>Browse all guides →</a>
      </nav>
    </div>
  </section>
</div>
