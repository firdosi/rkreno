---
import CorePageTitle from './core/CorePageTitle.astro';
import Prompt23ArchiveSidebar from './archive/Prompt23ArchiveSidebar.astro';
import type { RetainedArticle } from '@data/retained-article-catalog';
interface Archive { type: string; title: string; description: string; introduction: string; serviceHref: string; serviceLabel: string; }
const { archive, articles } = Astro.props as { archive: Archive; articles: RetainedArticle[]; sourceH1?: string; };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const date = (value: string) => new Date(`${value}T00:00:00`).toLocaleDateString('en-MY', { day: 'numeric', month: 'short', year: 'numeric' });
---
<div class="archive-exact-page">
  <CorePageTitle title={archive.title} description={archive.description} />
  <section class="p3-archive-intro"><div class="exact-wrap"><p class="core-kicker">{archive.type} ARCHIVE</p><h2>{archive.title}</h2><p>{archive.introduction}</p><a href={`${base}${archive.serviceHref}`}>{archive.serviceLabel} <span aria-hidden="true">→</span></a></div></section>
  <section class="archive-exact-section"><div class="exact-wrap p23-archive-layout">
    <div class="p23-archive-list">
      {articles.map((article) => <article class="p23-archive-entry">
        <a class="p23-entry-image" href={`${base}${article.route}`}><img src={`${base}${article.image}`} alt={article.imageAlt} width={article.imageWidth || 900} height={article.imageHeight || 600} loading="lazy" /></a>
        <div><p class="core-blog-meta"><span>{article.category}</span> · <time datetime={article.published}>{date(article.published)}</time></p><h2><a href={`${base}${article.route}`}>{article.title}</a></h2><p>{article.summary}</p><a class="p23-read-more" href={`${base}${article.route}`}>Read guide <span aria-hidden="true">→</span></a></div>
      </article>)}
    </div>
    <Prompt23ArchiveSidebar />
  </div></section>
</div>
