---
import { pakejDeepCleaningRumahKl as content, cleaningImages as images } from '../../data/pakej-deep-cleaning-rumah-kl';
import CleaningHeroOverview from './CleaningHeroOverview.astro';
import CleaningScopePricing from './CleaningScopePricing.astro';
import CleaningSeasonalAddons from './CleaningSeasonalAddons.astro';
import CleaningClosing from './CleaningClosing.astro';
import '../../styles/pakej-deep-cleaning-rumah-kl.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const localHref = (href: string) => href.startsWith('/') ? `${base}${href}` : href;
---
<article class="cleaning-page" data-pakej-deep-cleaning-rumah-kl data-article-recovery data-locked-template="article">
  <CleaningHeroOverview content={content} images={images} localHref={localHref} />
  <CleaningScopePricing content={content} images={images} localHref={localHref} />
  <CleaningSeasonalAddons content={content} images={images} localHref={localHref} />
  <CleaningClosing content={content} localHref={localHref} />
</article>
