---
import CorePageTitle from '../core/CorePageTitle.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const stages = [['01','Existing condition','Photograph affected rooms, finishes, services and access points.'],['02','Requested outcome','List the work required and identify features or areas that must remain.'],['03','Site constraints','Confirm measurements, management rules, work hours, protection and debris routes.'],['04','Quotation review','Compare the defined scope, materials, exclusions and possible additions.']];
---
<div class="held-page p3-restored-page">
  <CorePageTitle title="Our Projects 2" description="Property preparation references and a practical pre-quotation workflow, without unverified project claims." />
  <section class="core-section"><div class="exact-wrap p3-restored-hero"><div><p class="core-kicker">PROPERTY PREPARATION REFERENCES</p><h2>Turn Site Information into a Work Brief</h2><p>This second preserved projects URL has a distinct planning role. It explains how to prepare property information before renovation, repair or installation work is quoted.</p><p>The imagery is neutral service material and is not labelled as a completed RK Reno project.</p></div><img src={`${base}/assets/media/Modern-building-renovation-and-property-improvement-b1ec6039.jpg`} alt="Neutral property improvement reference, not a verified RK Reno project" width="1200" height="896" /></div></section>
  <section class="core-section p3-restored-tint"><div class="exact-wrap"><p class="core-kicker">PRE-QUOTATION WORKFLOW</p><h2>Prepare a Clear Property Brief</h2><div class="p3-stage-grid">{stages.map(([number,title,text]) => <article><strong>{number}</strong><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
  <section class="core-section"><div class="exact-wrap p3-restored-split"><img src={`${base}/assets/media/Renovation-planning-and-project-drawings-6cfdb2fc.jpg`} alt="Renovation requirements being reviewed before quotation" width="1200" height="896" loading="lazy" /><div><h2>Continue to the Relevant Service</h2><p>Browse the service directory for renovation, aircond, electrical, waterproofing, ceiling, cleaning and demolition information.</p><div class="core-button-row"><a class="core-button core-button-orange" href={`${base}/services/`}>View Services</a><a class="core-button core-button-outline" href={`${base}/contact-us/`}>Contact RK Reno</a></div></div></div></section>
</div>
