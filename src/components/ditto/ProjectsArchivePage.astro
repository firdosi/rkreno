---
import CorePageTitle from '../core/CorePageTitle.astro';
import { coreServices } from '@data/core-pages';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const references = coreServices.filter((item) => ['/house-renovation-in-kuala-lumpur/','/office-renovation-in-kuala-lumpur/','/waterproofing-contractor-kuala-lumpur/','/plaster-ceiling-contractor-kl/','/electrical-services-selangor/','/demolition-contractor-kl-selangor/'].includes(item.href));
---
<div class="held-page p3-restored-page">
  <CorePageTitle title="Our Projects" description="A source-safe property work-scope gallery using neutral service imagery, not unverified RK Reno project claims." />
  <section class="core-section"><div class="exact-wrap p3-restored-intro"><p class="core-kicker">WORK-SCOPE GALLERY</p><h2>Plan the Type of Property Work You Need</h2><p>No verified client names, project locations, completion dates, values or case-study outcomes are available for this restored route. The cards below use service imagery only and do not represent completed RK Reno projects.</p></div></section>
  <section class="core-section p3-restored-tint"><div class="exact-wrap p3-reference-grid">{references.map((item) => <article><a href={`${base}${item.href}`}><img src={`${base}${item.image}`} alt={`Neutral service illustration for ${item.title}; not a verified completed project`} width="900" height="650" loading="lazy" /></a><div><h2><a href={`${base}${item.href}`}>{item.title}</a></h2><p>{item.text}</p><a href={`${base}${item.href}`}>Review service scope <span aria-hidden="true">→</span></a></div></article>)}</div></section>
  <section class="core-section"><div class="exact-wrap p3-restored-cta"><div><p class="core-kicker">START WITH THE ACTUAL SITE</p><h2>Share Photos and Required Work</h2><p>A useful enquiry identifies retained areas, requested changes, access rules and the intended finish.</p></div><a class="core-button core-button-orange" href="https://wa.me/601111334496">Send Project Details</a></div></section>
</div>
