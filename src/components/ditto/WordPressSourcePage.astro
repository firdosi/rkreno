---
import { load } from 'cheerio';
import CorePageTitle from '../core/CorePageTitle.astro';

interface Props {
  route: string;
  title: string;
  content: string;
}

const { route, title, content } = Astro.props;
const $ = load(content);
const clean = (value = '') => value.replace(/\s+/g, ' ').trim();
const sourceHeading = clean($('h1,h2').first().text());
const pageTitle = title.replace(/\s+-\s+RK Reno Solution$/, '');
---
<div class={`ditto-source-page ditto-source-${route.replaceAll('/', '') || 'home'}`} data-source-route={route}>
  <CorePageTitle title={pageTitle} description={sourceHeading || pageTitle} />
  <section class="ditto-source-document ditto-reveal" aria-label={`${pageTitle} WordPress content`}>
    <div class="exact-wrap wordpress-source-content" set:html={content} />
  </section>
</div>

<script>
  const sourceDocument = document.querySelector<HTMLElement>('.ditto-source-document');
  if (sourceDocument) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      sourceDocument.classList.add('is-visible');
    } else {
      const observer = new IntersectionObserver(([entry]) => {
        if (!entry?.isIntersecting) return;
        sourceDocument.classList.add('is-visible');
        observer.disconnect();
      }, { threshold: 0.05 });
      observer.observe(sourceDocument);
    }
    for (const viewport of sourceDocument.querySelectorAll<HTMLElement>('[dir="ltr"]')) {
      const track = viewport.firstElementChild as HTMLElement | null;
      if (!track || track.children.length < 2) continue;
      let active = 0;
      const controls = document.createElement('div');
      controls.className = 'ditto-source-controls';
      controls.innerHTML = '<button type="button" aria-label="Previous slide">←</button><button type="button" aria-label="Next slide">→</button>';
      const show = (next: number) => {
        active = (next + track.children.length) % track.children.length;
        const card = track.children[active] as HTMLElement;
        track.style.transform = `translateX(-${card.offsetLeft}px)`;
      };
      const [previous, next] = controls.querySelectorAll('button');
      previous.addEventListener('click', () => show(active - 1));
      next.addEventListener('click', () => show(active + 1));
      viewport.after(controls);
      if (!reduced) window.setInterval(() => show(active + 1), 6500);
    }
  }
</script>
