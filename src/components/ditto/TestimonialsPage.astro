---
import CorePageTitle from '../core/CorePageTitle.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const steps = [['Prepare the enquiry','Share the property location, photos, dimensions and required work.'],['Review the scope','Discuss access, materials, quantities, exclusions and whether inspection is needed.'],['Confirm the quotation','Check the agreed work, payment stages and treatment of additional items.'],['Keep changes explicit','Confirm scope changes before extra work or materials are added.']];
---
<div class="held-page p3-restored-page">
  <CorePageTitle title="Testimonials" description="A source-safe explanation of RK Reno quotation and communication steps; unverified template testimonials are excluded." />
  <section class="core-section"><div class="exact-wrap p3-restored-hero"><div><p class="core-kicker">SOURCE REVIEW</p><h2>No Unverified Testimonials Are Displayed</h2><p>The restored source contained template names, portraits and testimonial wording without supporting evidence. Those items are classified <strong>REMOVE_BEFORE_PRODUCTION</strong> and are not shown as customer reviews.</p><p>No customer-review or aggregate-rating structured data is used on this page.</p></div><img src={`${base}/assets/media/ct-08-a16e9952.webp`} alt="Preparing a property-service enquiry with RK Reno Solution" width="526" height="556" /></div></section>
  <section class="core-section p3-restored-tint"><div class="exact-wrap"><p class="core-kicker">WHAT CUSTOMERS SHOULD EXPECT</p><h2>Quotation and Communication Steps</h2><div class="p3-stage-grid">{steps.map(([title,text],index) => <article><strong>{String(index+1).padStart(2,'0')}</strong><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
  <section class="core-section"><div class="exact-wrap p3-restored-cta"><div><h2>Discuss Your Property Directly</h2><p>Use WhatsApp or the published phone number for an active enquiry. The staging form remains preview-only.</p></div><div class="core-button-row"><a class="core-button core-button-orange" href="https://wa.me/601111334496">WhatsApp RK Reno</a><a class="core-button core-button-outline" href={`${base}/contact-us/`}>Contact Details</a></div></div></section>
</div>
