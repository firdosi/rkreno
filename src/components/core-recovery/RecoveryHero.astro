---
const { eyebrow, title, lead, image, alt, compact = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<header class:list={['recovery-hero', { 'recovery-hero-compact': compact }]}>
  <div class="recovery-wrap recovery-hero-grid">
    <div class="recovery-hero-copy">
      <p class="recovery-eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      {lead && <p>{lead}</p>}
      <div class="recovery-actions">
        <a class="recovery-button recovery-button-orange" href="https://wa.me/601111334496">WhatsApp RK Reno</a>
        <a class="recovery-button recovery-button-outline" href={`${base}/contact-us/`}>Request a quotation</a>
      </div>
    </div>
    {image && <figure><img src={`${base}${image}`} alt={alt} width="960" height="720" /></figure>}
  </div>
</header>
