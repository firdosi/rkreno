---
const { card, image, action = 'View service' } = Astro.props as any;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<a class="recovery-service-card" href={`${base}${card.route}`}>
  <img src={`${base}${image}`} alt={`${card.title} service from RK Reno Solution`} width="720" height="480" loading="lazy" />
  <span class="recovery-service-card-copy">
    <strong>{card.title}</strong>
    <span>{card.description}</span>
    <small>{action} <span aria-hidden="true">→</span></small>
  </span>
</a>
