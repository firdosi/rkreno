---
import { getMediaDimensions } from '@data/media-dimensions';
interface Props {
  block: {
    type: 'heading' | 'paragraph' | 'list' | 'table' | 'image' | 'link';
    text?: string;
    html?: string;
    ordered?: boolean;
    items?: (string | { text: string; html: string })[];
    rows?: string[][];
    src?: string;
    alt?: string;
    href?: string;
  };
}

const { block } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dimensions = block.src ? getMediaDimensions(block.src) : undefined;
const liveOnlyRoutes = [
  '/about/',
  '/service/building-construction/',
  '/service/architecture-design/',
  '/service/flooring-roofing/',
  '/service/general-contracting/',
  '/service/repair-expand/',
];
const safeHtml = (value = '') => {
  let html = value;
  for (const route of liveOnlyRoutes) html = html.replaceAll(`href="${route}`, `href="https://rkrenosolution.com${route}`);
  return html.replaceAll('href="/', `href="${base}/`);
};
---
{block.type === 'paragraph' ? <p set:html={safeHtml(block.html || block.text)} />
  : block.type === 'link' && block.href ? <a class="core-button" href={block.href.startsWith('/') ? `${base}${block.href}` : block.href}>{block.text}</a>
  : block.type === 'list' && block.ordered ? <ol>{block.items?.map((item) => <li set:html={safeHtml(typeof item === 'string' ? item : item.html)} />)}</ol>
  : block.type === 'list' ? <ul>{block.items?.map((item) => <li set:html={safeHtml(typeof item === 'string' ? item : item.html)} />)}</ul>
  : block.type === 'image' && block.src ? (
    <figure>
      <img
        src={`${base}${block.src}`}
        alt={block.alt || ''}
        width={dimensions?.width}
        height={dimensions?.height}
        loading="lazy"
        decoding="async"
      />
      <figcaption>{block.alt}</figcaption>
    </figure>
  )
  : block.type === 'table' ? (
    <div class="service-responsive-table">
      <table><tbody>{block.rows?.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody></table>
    </div>
  )
  : null}
