---
import type { ServiceFaq } from '@data/service-exact-faqs';

interface Props {
  title: string;
  faqs: ServiceFaq[];
}

const { title, faqs } = Astro.props;
---
<section class="service-exact-section service-exact-section--faq">
  <div class="exact-wrap">
    <header class="service-exact-heading">
      <p>Frequently Asked Questions</p>
      <h2>{title}</h2>
    </header>
    <div class="service-exact-faqs">
      {faqs.map((faq) => (
        <details>
          <summary>{faq.question}<span aria-hidden="true">+</span></summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
