---
import CoreFinalCta from '../core/CoreFinalCta.astro';
import ServiceExactHero from './ServiceExactHero.astro';
import ServiceExactSection from './ServiceExactSection.astro';
import { serviceExactConfig } from '@data/service-exact-config';
import { priceCardsByRoute, priceTablesByRoute, pricingSectionPattern } from '@data/service-exact-pricing';

interface Props {
  route: string;
  title: string;
  sourceHeroTitle?: string;
  sourceHeroLead?: string;
  sourceHeroActions?: { href: string; label: string }[];
  parityContent: { sections: any[] };
}

const { route, title, sourceHeroTitle, sourceHeroLead, sourceHeroActions, parityContent } = Astro.props;
const config = serviceExactConfig[route];
const priceCards = priceCardsByRoute[route];
const priceTable = priceTablesByRoute[route];
const prompt22Routes = [
  '/electrical-services-selangor/',
  '/home-renovation-contractor-in-subang-jaya/',
  '/office-renovation-in-kuala-lumpur/',
  '/waterproofing-contractor-kuala-lumpur/',
  '/plaster-ceiling-contractor-kl/',
  '/servis-cuci-rumah-kl/',
];
const prompt22 = prompt22Routes.includes(route);
---
<div class:list={['service-exact-page', `service-exact-page--${config.variant}`, { 'service-exact-page--prompt22': prompt22 }]}>
  <ServiceExactHero title={title} config={config} sourceHeroTitle={sourceHeroTitle} sourceHeroLead={sourceHeroLead} sourceHeroActions={sourceHeroActions} />
  {parityContent.sections.map((section, index) => (
    <ServiceExactSection
      section={section}
      index={index}
      skipPatterns={[]}
      priceCards={priceCards}
      priceTable={index === 0 ? priceTable : undefined}
      explicitFaqs={undefined}
      pricingSection={pricingSectionPattern.test(section.title)}
      prompt22Primary={prompt22 && index === 0 && route !== '/office-renovation-in-kuala-lumpur/'}
    />
  ))}
  <CoreFinalCta />
</div>
