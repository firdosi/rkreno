---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import ContactForm from '@components/ContactForm.astro';
import Batch1Page from '@components/Batch1Page.astro';
import ExactHomePage from '@components/home/ExactHomePage.astro';
import CoreServicesPage from '@components/core/CoreServicesPage.astro';
import CoreAboutPage from '@components/core/CoreAboutPage.astro';
import CoreContactPage from '@components/core/CoreContactPage.astro';
import CoreFaqPage from '@components/core/CoreFaqPage.astro';
import CoreBlogPage from '@components/core/CoreBlogPage.astro';
import ServiceExactPage from '@components/service/ServiceExactPage.astro';
import ArticlePage from '@components/ArticlePage.astro';
import ThankYouPage from '@components/ThankYouPage.astro';
import TaxonomyArchive from '@components/TaxonomyArchive.astro';
import PriorityPageHero from '@components/PriorityPageHero.astro';
import pages from '@data/site-pages.json';
import routePolicy from '@data/route-policy.json';
import { batch1Pages } from '@data/batch1-pages';
import { batch1ServicePages } from '@data/batch1-service-pages';
import { batch2Pages } from '@data/batch2-pages';
import { batch2Articles } from '@data/batch2-articles';
import { batch3Articles } from '@data/batch3';
import { batch3Pages } from '@data/batch3-pages';
import taxonomyArchives from '@data/taxonomy-archives.json';
import { retainedArticleByRoute } from '@data/retained-article-catalog';
import { serviceExactConfig } from '@data/service-exact-config';
import { serviceFaqsByRoute } from '@data/service-exact-faqs';
import { coreFaqs } from '@data/core-pages';
import wordpressParityContent from '@data/wordpress-parity-content.json';
import articleWordpressContent from '@data/article-wordpress-content.json';
import { isIndexable } from '../config/runtime';

interface PageRecord {
  path: string;
  status: number;
  type: string;
  title: string;
  description: string;
  canonical: string;
  h1: string;
  content: string;
  schema: unknown[];
  og?: { image?: string };
  customLayout?: boolean;
  externalStyles?: string[];
}

export function getStaticPaths() {
  const excluded = new Set(routePolicy.excluded);
  const retiredTaxonomies = new Set(Object.entries(taxonomyArchives)
    .filter(([, archive]) => archive.action !== 'KEEP_NOINDEX_NATIVE')
    .map(([route]) => route));
  return (pages as PageRecord[])
    .filter((page) =>
      page.status === 200
      && page.type !== 'template'
      && page.title
      && !excluded.has(page.path)
      && !retiredTaxonomies.has(page.path)
    )
    .map((page) => ({
      params: { slug: page.path === '/' ? undefined : page.path.replace(/^\/|\/$/g, '') },
      props: { page }
    }));
}

const { page } = Astro.props as { page: PageRecord };
const batchPage = batch1Pages[page.path] || batch1ServicePages[page.path] || batch2Pages[page.path] || batch3Pages[page.path];
const exactArticle = articleWordpressContent[page.path as keyof typeof articleWordpressContent];
const sourceArticle = batch2Articles[page.path] || batch3Articles[page.path];
const catalogArticle = retainedArticleByRoute[page.path];
const batchArticle = sourceArticle || (exactArticle && catalogArticle ? {
  ...catalogArticle,
  modified: exactArticle.modified,
  sections: [],
  serviceHref: '/upah-pasang-aircond-selangor/',
  serviceLabel: 'Aircond installation Selangor',
  related: [
    { href: '/aircond-installation-kl/', label: 'Aircond Installation KL' },
    { href: '/servis-aircond-murah-kl/', label: 'Aircond servicing' },
  ],
} : undefined);
const taxonomyArchive = taxonomyArchives[page.path as keyof typeof taxonomyArchives];
const nativeTaxonomy = taxonomyArchive?.action === 'KEEP_NOINDEX_NATIVE' ? taxonomyArchive : undefined;
const taxonomyArticles = nativeTaxonomy && 'articles' in nativeTaxonomy
  ? nativeTaxonomy.articles.map((route) => retainedArticleByRoute[route]).filter(Boolean)
  : [];
const nativePage = Boolean(batchPage || batchArticle || nativeTaxonomy || ['/faq/', '/blog/', '/thank-you/'].includes(page.path));
const parityContent = wordpressParityContent[page.path as keyof typeof wordpressParityContent];
const sourceTitleIsSafe = !/\bRM\s*\d|guarantee|warranty|24\s*\/\s*7|\d+\+?\s+(?:customers|projects|years)/i.test(page.title);
const layoutTitle = sourceTitleIsSafe
  ? page.title
  : nativeTaxonomy ? `${nativeTaxonomy.title} - RK Reno Solution`
    : batchArticle ? `${batchArticle.title} - RK Reno Solution`
      : batchPage ? `${batchPage.title} - RK Reno Solution` : page.title;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repairedLinks = [
  ['/about/', '/about-us/'],
  ['/services/%20https://rkrenosolution.com/about-us/', '/about-us/'],
  ['/6-ways-to-get-the-most-out-of-your-project-search-software', '/blog/'],
  ['/portfolio/commercial/', '/our-projects/'],
  ['/portfolio/electrical/', '/our-projects/'],
  ['/portfolio/home-renovation/', '/our-projects/'],
  ['/portfolio/office-renovation/', '/our-projects/'],
  ['/portfolio/residential/', '/our-projects/'],
  ['/portfolio/stadium/', '/our-projects/'],
  ['/portfolio/waterproofing/', '/our-projects/'],
  ['/home-2/', '/home-2-2/'],
  ['/blog/page/2/', '/blog/'],
  ['/blog/page/4/', '/blog/'],
  ['/tag/ceiling-works/', '/category/interior-design/'],
  ['/tag/kuala-lumpur/', '/category/servis-pembersihan/'],
  ['/tag/wiring/', '/category/technical-guides/'],
  ['/wp-admin/', '/']
];
let repairedContent = page.content;
for (const [source, target] of repairedLinks) repairedContent = repairedContent.replaceAll(source, target);
const missingImages = [
  'deep-cleaning-rumah-kuala-lumpur.webp',
  'cuci-bilik-air-rumah-kl.webp',
  'pakej-cuci-rumah-hari-raya.webp',
  'cucian-selepas-renovasi-rumah.webp',
  'cuci-dapur-rumah-berminyak.webp',
  'cuci-habuk-plaster-ceiling.webp',
  'servis-aircond-dan-cuci-rumah.webp'
];
for (const filename of missingImages) {
  repairedContent = repairedContent.replaceAll(`/wp-content/uploads/2026/04/${filename}`, '');
}
const content = repairedContent
  .replaceAll('href="/', `href="${base}/`)
  .replaceAll('src="/', `src="${base}/`);
const coreRoutes = ['/', '/services/', '/about-us/', '/contact-us/', '/faq/', '/blog/'];
const serviceExact = serviceExactConfig[page.path];
const showForm = page.path === '/contact-us/' && !coreRoutes.includes(page.path);
const pageSchema = batchArticle
  ? [{
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: exactArticle?.sourceTitle || batchArticle.title,
      description: batchArticle.summary,
      datePublished: exactArticle?.published || batchArticle.published,
      dateModified: exactArticle?.modified || batchArticle.modified,
      author: { '@type': 'Organization', name: 'RK Reno Solution' },
      publisher: { '@type': 'LocalBusiness', name: 'RK Reno Solution' },
      mainEntityOfPage: page.canonical,
    }, ...(exactArticle?.faqs?.length ? [{
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: exactArticle.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    }] : [])]
  : page.path === '/faq/'
  ? [{
      '@context': 'https://schema.org', '@type': 'FAQPage',
      name: 'Frequently Asked Questions', url: page.canonical,
      mainEntity: coreFaqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    }]
  : page.path === '/blog/'
  ? [{
      '@context': 'https://schema.org', '@type': 'CollectionPage',
      name: 'RK Reno Solution Blog', url: page.canonical,
      description: 'Practical renovation and property-service guides from RK Reno Solution.',
    }]
  : nativeTaxonomy
  ? [{
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: nativeTaxonomy.title,
      description: nativeTaxonomy.description,
      url: page.canonical,
      isPartOf: { '@id': 'https://rkrenosolution.com/#website' },
      hasPart: taxonomyArticles.map((article) => ({
        '@type': 'BlogPosting',
        headline: article.title,
        url: `https://rkrenosolution.com${article.route}`,
      })),
    }]
  : serviceExact
  ? [{
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: page.title,
      description: page.description,
      url: page.canonical,
      areaServed: ['Kuala Lumpur', 'Selangor'],
      provider: { '@type': 'LocalBusiness', name: 'RK Reno Solution' },
    }, ...(serviceFaqsByRoute[page.path]?.length ? [{
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: serviceFaqsByRoute[page.path].map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    }] : [])]
  : batch3Pages[page.path]
  ? [{
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: batchPage?.title,
      description: batchPage?.summary,
      url: page.canonical,
      areaServed: 'Kuala Lumpur',
      provider: { '@type': 'Organization', name: 'RK Reno Solution' },
    }]
  : nativePage
  ? [{
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      '@id': page.canonical,
      url: page.canonical,
      name: batchPage?.title || page.title,
      description: batchPage?.summary || (page.path === '/faq/'
        ? 'Answers about renovation, aircond, electrical, waterproofing, ceiling, quotation and service areas.'
        : 'Practical renovation and property-service guides from RK Reno Solution.'),
      isPartOf: { '@id': 'https://rkrenosolution.com/#website' },
    }]
  : page.schema;
---
<BaseLayout
  title={layoutTitle}
  description={nativeTaxonomy?.description || batchArticle?.summary || batchPage?.summary || (page.path === '/blog/'
    ? 'Practical renovation and property-service guides from RK Reno Solution.'
    : page.path === '/faq/'
      ? 'Answers about renovation, aircond, electrical, waterproofing, ceiling, quotation and service areas.'
      : page.description)}
  canonical={page.canonical}
  ogImage={page.og?.image}
  schema={pageSchema}
  pageType={page.type}
  externalStyles={nativePage ? [] : page.externalStyles}
  robots={nativeTaxonomy ? (isIndexable ? 'noindex, follow' : 'noindex, nofollow')
    : page.path === '/thank-you/' ? 'noindex, nofollow' : undefined}
  exactHome={page.path === '/'}
  wordpressCore={coreRoutes.includes(page.path) || Boolean(serviceExact) || Boolean(batchArticle) || Boolean(nativeTaxonomy) || page.path === '/thank-you/'}
>
  {batchArticle ? (
    <ArticlePage article={batchArticle} wordpressContent={exactArticle} />
  ) : page.path === '/' ? (
    <ExactHomePage />
  ) : page.path === '/services/' ? (
    <CoreServicesPage />
  ) : page.path === '/about-us/' ? (
    <CoreAboutPage />
  ) : page.path === '/contact-us/' ? (
    <CoreContactPage />
  ) : page.path === '/faq/' ? (
    <CoreFaqPage />
  ) : page.path === '/blog/' ? (
    <CoreBlogPage />
  ) : serviceExact && parityContent ? (
    <ServiceExactPage route={page.path} title={parityContent.sourceH1 || page.title} parityContent={parityContent} />
  ) : page.path === '/thank-you/' ? (
    <ThankYouPage />
  ) : nativeTaxonomy ? (
    <TaxonomyArchive archive={nativeTaxonomy} articles={taxonomyArticles} path={page.path} sourceH1={page.h1} />
  ) : batchPage ? (
    <Batch1Page page={batchPage} path={page.path} parityContent={parityContent} sourceH1={parityContent?.sourceH1} />
  ) : (
    <>
  {page.path !== '/' && !page.customLayout && (
    <>
      <section class="page-hero">
        <div class="wrap">
          <p class="eyebrow">{page.type}</p>
          <h1>{page.h1 || page.title}</h1>
        </div>
      </section>
      <Breadcrumbs path={page.path} title={page.h1 || page.title} />
    </>
  )}
  {page.path !== '/' && page.customLayout && (
    <PriorityPageHero
      title={page.h1 || page.title}
      description={page.path === '/services/'
        ? 'Our expertise combines visionary design with practical execution, ensuring functional, beautiful spaces that meet the demands of modern life and exceed expectations.'
        : 'Description Details'}
    />
  )}
  <article
    class:list={[
      page.customLayout ? 'custom-content' : 'legacy-content',
      {
        'home-content': page.path === '/',
        'theme-content': Boolean(page.externalStyles?.length)
      }
    ]}
    set:html={content}
  />
    </>
  )}
  {showForm && (
    <section class="section-space form-section">
      <div class="wrap">
        <div class="section-heading">
          <p class="eyebrow">Enquiry form</p>
          <h2>Send Your Project Details</h2>
        </div>
        <ContactForm />
      </div>
    </section>
  )}
</BaseLayout>
