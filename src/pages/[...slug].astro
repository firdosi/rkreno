---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import ContactForm from '@components/ContactForm.astro';
import Batch1Page from '@components/Batch1Page.astro';
import ExactHomePage from '@components/home/ExactHomePage.astro';
import CoreServicesPage from '@components/core/CoreServicesPage.astro';
import CoreAboutPage from '@components/core/CoreAboutPage.astro';
import CoreContactPage from '@components/core/CoreContactPage.astro';
import CoreFaqPage from '@components/core/CoreFaqPage.astro';
import CoreBlogPage from '@components/core/CoreBlogPage.astro';
import ServiceExactPage from '@components/service/ServiceExactPage.astro';
import ArticlePage from '@components/ArticlePage.astro';
import ThankYouPage from '@components/ThankYouPage.astro';
import TaxonomyArchive from '@components/TaxonomyArchive.astro';
import PriorityPageHero from '@components/PriorityPageHero.astro';
import DemolitionPage from '@components/ditto/DemolitionPage.astro';
import CompanyHistoryPage from '@components/ditto/CompanyHistoryPage.astro';
import ProjectsArchivePage from '@components/ditto/ProjectsArchivePage.astro';
import ProjectsAlternatePage from '@components/ditto/ProjectsAlternatePage.astro';
import TeamPage from '@components/ditto/TeamPage.astro';
import TestimonialsPage from '@components/ditto/TestimonialsPage.astro';
import pages from '@data/site-pages.json';
import routePolicy from '@data/route-policy.json';
import { batch1Pages } from '@data/batch1-pages';
import { batch1ServicePages } from '@data/batch1-service-pages';
import { batch2Pages } from '@data/batch2-pages';
import { batch2Articles } from '@data/batch2-articles';
import { batch3Articles } from '@data/batch3';
import { batch3Pages } from '@data/batch3-pages';
import taxonomyArchives from '@data/taxonomy-archives.json';
import { retainedArticleByRoute } from '@data/retained-article-catalog';
import { serviceExactConfig } from '@data/service-exact-config';
import { serviceFaqsByRoute } from '@data/service-exact-faqs';
import { coreFaqs } from '@data/core-pages';
import wordpressParityContent from '@data/wordpress-parity-content.json';
import articleWordpressContent from '@data/article-wordpress-content.json';
import { isIndexable } from '../config/runtime';

interface PageRecord {
  path: string;
  status: number;
  type: string;
  title: string;
  description: string;
  canonical: string;
  h1: string;
  content: string;
  schema: unknown[];
  og?: { image?: string };
  customLayout?: boolean;
  externalStyles?: string[];
  images?: { source: string; local: string; alt?: string }[];
}

const heldRoutes = new Set(['/company-history/', '/our-projects-2/', '/our-projects/', '/our-team/', '/testimonials/']);
const demolitionPage: PageRecord = {
  path: '/demolition-contractor-kl-selangor/',
  status: 200,
  type: 'service',
  title: 'Demolition Contractor KL & Selangor - RK Reno Solution',
  description: 'Interior demolition, bathroom demolition, strip-out, site preparation and debris-removal enquiries in Kuala Lumpur and Selangor.',
  canonical: 'https://rkrenosolution.com/demolition-contractor-kl-selangor/',
  h1: 'Demolition Contractor KL & Selangor',
  content: '',
  schema: [],
};

export function getStaticPaths() {
  const staticHeldRoutes = new Set(['/company-history/', '/our-projects-2/', '/our-projects/', '/our-team/', '/testimonials/']);
  const staticDemolitionPage: PageRecord = {
    path: '/demolition-contractor-kl-selangor/',
    status: 200,
    type: 'service',
    title: 'Demolition Contractor KL & Selangor - RK Reno Solution',
    description: 'Interior demolition, bathroom demolition, strip-out, site preparation and debris-removal enquiries in Kuala Lumpur and Selangor.',
    canonical: 'https://rkrenosolution.com/demolition-contractor-kl-selangor/',
    h1: 'Demolition Contractor KL & Selangor',
    content: '',
    schema: [],
  };
  const excluded = new Set(routePolicy.excluded);
  for (const route of staticHeldRoutes) excluded.delete(route);
  const retiredTaxonomies = new Set(Object.entries(taxonomyArchives)
    .filter(([, archive]) => archive.action !== 'KEEP_NOINDEX_NATIVE')
    .map(([route]) => route));
  return [...(pages as PageRecord[]), staticDemolitionPage]
    .filter((page) =>
      page.status === 200
      && page.type !== 'template'
      && page.title
      && !excluded.has(page.path)
      && !retiredTaxonomies.has(page.path)
    )
    .map((page) => ({
      params: { slug: page.path === '/' ? undefined : page.path.replace(/^\/|\/$/g, '') },
      props: { page }
    }));
}

const { page } = Astro.props as { page: PageRecord };
const isHeldRoute = heldRoutes.has(page.path);
const isDemolition = page.path === demolitionPage.path;
const batchPage = batch1Pages[page.path] || batch1ServicePages[page.path] || batch2Pages[page.path] || batch3Pages[page.path];
const exactArticle = articleWordpressContent[page.path as keyof typeof articleWordpressContent];
const sourceArticle = batch2Articles[page.path] || batch3Articles[page.path];
const catalogArticle = retainedArticleByRoute[page.path];
const batchArticle = sourceArticle ? { ...catalogArticle, ...sourceArticle, route: page.path } : (exactArticle && catalogArticle ? {
  ...catalogArticle,
  modified: exactArticle.modified,
  sections: [],
  serviceHref: '/upah-pasang-aircond-selangor/',
  serviceLabel: 'Aircond installation Selangor',
  related: [
    { href: '/aircond-installation-kl/', label: 'Aircond Installation KL' },
    { href: '/servis-aircond-murah-kl/', label: 'Aircond servicing' },
  ],
} : undefined);
const taxonomyArchive = taxonomyArchives[page.path as keyof typeof taxonomyArchives];
const nativeTaxonomy = taxonomyArchive?.action === 'KEEP_NOINDEX_NATIVE' ? taxonomyArchive : undefined;
const taxonomyArticles = nativeTaxonomy && 'articles' in nativeTaxonomy
  ? nativeTaxonomy.articles.map((route) => retainedArticleByRoute[route]).filter(Boolean)
  : [];
const nativePage = Boolean(batchPage || batchArticle || nativeTaxonomy || isHeldRoute || isDemolition || ['/faq/', '/blog/', '/thank-you/'].includes(page.path));
const parityContent = wordpressParityContent[page.path as keyof typeof wordpressParityContent];
const sourceTitleIsSafe = !/\bRM\s*\d|guarantee|warranty|24\s*\/\s*7|\d+\+?\s+(?:customers|projects|years)/i.test(page.title);
const layoutTitle = sourceTitleIsSafe
  ? page.title
  : nativeTaxonomy ? `${nativeTaxonomy.title} - RK Reno Solution`
    : batchArticle ? `${batchArticle.title} - RK Reno Solution`
      : batchPage ? `${batchPage.title} - RK Reno Solution` : page.title;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repairedLinks = [
  ['/about/', 'https://rkrenosolution.com/about/'],
  ['/services/%20https://rkrenosolution.com/about-us/', '/about-us/'],
  ['/6-ways-to-get-the-most-out-of-your-project-search-software', '/blog/'],
  ['/home-2/', '/home-2-2/'],
  ['/blog/page/2/', 'https://rkrenosolution.com/blog/page/2/'],
  ['/blog/page/4/', 'https://rkrenosolution.com/blog/page/4/'],
  ['/tag/ceiling-works/', 'https://rkrenosolution.com/tag/ceiling-works/'],
  ['/tag/kuala-lumpur/', 'https://rkrenosolution.com/tag/kuala-lumpur/'],
  ['/tag/wiring/', 'https://rkrenosolution.com/tag/wiring/'],
  ['/category/interior-design/', 'https://rkrenosolution.com/category/interior-design/'],
  ['/tag/aircond-maintenance/', 'https://rkrenosolution.com/tag/aircond-maintenance/'],
  ['/tag/cleaning/', 'https://rkrenosolution.com/tag/cleaning/'],
  ['/tag/guide/', 'https://rkrenosolution.com/tag/guide/'],
  ['/tag/pemasangan-aircond/', 'https://rkrenosolution.com/tag/pemasangan-aircond/'],
  ['/wp-admin/', '/']
];
let repairedContent = page.content;
for (const [source, target] of repairedLinks) repairedContent = repairedContent.replaceAll(source, target);
const articleImageFallbacks: Record<string, string[]> = {
  '/commercial-retail-shop-renovation-in-kuala-lumpur/': ['/assets/media/Renovation-contractor-for-commercial-buildings-93583952.jpg'],
  '/office-renovation-petaling-jaya-corporate-fit-out-experts/': ['/assets/media/Office-renovation-service-in-Selangor-7928d19d.jpg'],
  '/waterproofing-contractor-kuala-lumpur-the-complete-guide-to-stopping-leaks-2026/': ['/assets/media/Bathroom-waterproofing-service-in-KL-3293ca94.jpg'],
  '/plaster-ceiling-contractor-kl-the-ultimate-design-pricing-guide-2026/': ['/assets/media/Plaster-ceiling-and-aircond-installation-dd789b38.jpg'],
  '/house-renovation-in-kuala-lumpur-the-ultimate-planning-cost-guide-2026/': [
    '/assets/media/Home-renovation-service-in-KL-422b205c.jpg',
    '/assets/media/Renovation-planning-and-project-drawings-1-ea76b170.jpg',
  ],
  '/house-renovation-in-selangor-the-ultimate-2026-guide-to-extending-your-home/': [
    '/assets/media/Modern-building-renovation-and-property-improvement-b1ec6039.jpg',
    '/assets/media/Renovation-planning-and-project-drawings-6cfdb2fc.jpg',
  ],
  '/office-renovation-in-kuala-lumpur-the-2026-corporate-guide-to-productivity/': ['/assets/media/Office-renovation-service-in-Selangor-7928d19d.jpg'],
  '/pu-injection-waterproofing-kl-how-to-fix-wall-cracks-permanently/': ['/assets/media/Bathroom-waterproofing-service-in-KL-3293ca94.jpg'],
  '/servis-aircond-murah-kl-the-ultimate-2026-guide-to-a-colder-home/': ['/assets/media/owner/rk-reno-aircond-indoor-unit-service-access-960.webp'],
  '/servis-cuci-rumah-kl-the-ultimate-2026-guide-to-a-spotless-home/': ['/assets/media/detailed-kitchen-cleaning-kl-67669628.jpg'],
};
let fallbackIndex = 0;
for (const image of page.images || []) {
  if (!/^https?:/i.test(image.local || '')) continue;
  const fallbacks = articleImageFallbacks[page.path] || [];
  const replacement = /gravatar/i.test(image.source)
    ? '/assets/media/logo-iocn-6f17c44e.png'
    : fallbacks[fallbackIndex++ % Math.max(1, fallbacks.length)];
  if (!replacement) continue;
  repairedContent = repairedContent
    .replaceAll(image.source, replacement)
    .replaceAll(image.source.replaceAll('&', '&amp;'), replacement);
}
const missingImages = [
  'deep-cleaning-rumah-kuala-lumpur.webp',
  'cuci-bilik-air-rumah-kl.webp',
  'pakej-cuci-rumah-hari-raya.webp',
  'cucian-selepas-renovasi-rumah.webp',
  'cuci-dapur-rumah-berminyak.webp',
  'cuci-habuk-plaster-ceiling.webp',
  'servis-aircond-dan-cuci-rumah.webp'
];
for (const filename of missingImages) {
  repairedContent = repairedContent.replaceAll(
    `/wp-content/uploads/2026/04/${filename}`,
    '/assets/media/detailed-kitchen-cleaning-kl-67669628.jpg'
  );
}
if (page.path === '/our-team/') {
  repairedContent = repairedContent.replaceAll('href="/team-detail/"', 'href="/our-team/"');
}
const content = repairedContent
  .replaceAll('href="/', `href="${base}/`)
  .replaceAll('src="/', `src="${base}/`);
const sourceText = (value = '') => value
  .replace(/<[^>]+>/g, ' ')
  .replaceAll('&amp;', '&')
  .replaceAll('&#8211;', '–')
  .replaceAll('&#8217;', '’')
  .replace(/\s+/g, ' ')
  .replace(/\s+([.,!?;:])/g, '$1')
  .trim();
const sourceHeroMatch = page.content.match(/<h1[^>]*>([\s\S]*?)<\/h1>/i);
const sourceHeroTitle = sourceHeroMatch ? sourceText(sourceHeroMatch[1]) : '';
const sourceAfterHero = sourceHeroMatch ? page.content.slice((sourceHeroMatch.index || 0) + sourceHeroMatch[0].length) : '';
const sourceLeadMatch = sourceAfterHero.match(/<p[^>]*>([\s\S]*?)<\/p>/i);
const sourceHeroLead = sourceLeadMatch ? sourceText(sourceLeadMatch[1]) : '';
const sourceHeroActions = [...sourceAfterHero.matchAll(/<a[^>]*href=["']([^"']+)["'][^>]*>([\s\S]*?)<\/a>/gi)]
  .slice(0, 2)
  .map((match) => ({ href: match[1], label: sourceText(match[2]) }));
const coreRoutes = ['/', '/services/', '/about-us/', '/contact-us/', '/faq/', '/blog/'];
const serviceExact = serviceExactConfig[page.path];
const showForm = page.path === '/contact-us/' && !coreRoutes.includes(page.path);
const showDemolitionLink = [
  '/service/building-renovation/',
  '/house-renovation-in-kuala-lumpur/',
  '/house-renovation-in-selangor/',
  '/home-renovation-contractor-in-subang-jaya/',
  '/office-renovation-in-kuala-lumpur/',
].includes(page.path);
const heldDescriptions: Record<string, string> = {
  '/company-history/': 'Source-safe background on RK Reno Solution, its current services, work approach and operating areas.',
  '/our-projects/': 'A property work-scope gallery using neutral service imagery without unverified client or project claims.',
  '/our-projects-2/': 'Property preparation references and a practical workflow for preparing a pre-quotation brief.',
  '/our-team/': 'How RK Reno Solution handles inspection, planning, trade coordination and customer communication.',
  '/testimonials/': 'RK Reno quotation and communication steps with unverified template testimonials intentionally excluded.',
};
const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://rkrenosolution.com/' },
    { '@type': 'ListItem', position: 2, name: sourceHeroTitle || catalogArticle?.title || nativeTaxonomy?.title || page.h1 || page.title, item: page.canonical },
  ],
};
const pageSchema: any[] = isDemolition
  ? [{
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: 'Demolition Contractor KL & Selangor',
      description: demolitionPage.description,
      url: demolitionPage.canonical,
      serviceType: ['Interior demolition', 'Bathroom demolition', 'Office strip-out', 'Retail shop strip-out', 'Site preparation'],
      areaServed: ['Kuala Lumpur', 'Selangor'],
      provider: { '@type': 'LocalBusiness', name: 'RK Reno Solution' },
    }, {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: [
        ['Can you quote demolition work from photos?', 'Photos help with an initial enquiry, but a site inspection may be required before quotation.'],
        ['Do you remove structural walls?', 'Structural or load-bearing changes require separate professional assessment and any necessary approvals.'],
        ['Can demolition be combined with renovation work?', 'The removal and preparation scope can be discussed as part of a wider renovation enquiry.'],
        ['Which areas do you serve?', 'Enquiries are accepted for Kuala Lumpur and Selangor, subject to location and scope.'],
      ].map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })),
    }]
  : batchArticle
  ? [{
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: exactArticle?.sourceTitle || batchArticle.title,
      description: batchArticle.summary,
      datePublished: exactArticle?.published || batchArticle.published,
      dateModified: exactArticle?.modified || batchArticle.modified,
      author: { '@type': 'Organization', name: 'RK Reno Solution' },
      publisher: { '@type': 'LocalBusiness', name: 'RK Reno Solution' },
      mainEntityOfPage: page.canonical,
    }, ...(exactArticle?.faqs?.length ? [{
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: exactArticle.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    }] : [])]
  : page.path === '/faq/'
  ? [{
      '@context': 'https://schema.org', '@type': 'FAQPage',
      name: 'Frequently Asked Questions', url: page.canonical,
      mainEntity: coreFaqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    }]
  : page.path === '/blog/'
  ? [{
      '@context': 'https://schema.org', '@type': 'CollectionPage',
      name: 'RK Reno Solution Blog', url: page.canonical,
      description: 'Practical renovation and property-service guides from RK Reno Solution.',
    }]
  : nativeTaxonomy
  ? [{
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: nativeTaxonomy.title,
      description: nativeTaxonomy.description,
      url: page.canonical,
      isPartOf: { '@id': 'https://rkrenosolution.com/#website' },
      hasPart: taxonomyArticles.map((article) => ({
        '@type': 'BlogPosting',
        headline: article.title,
        url: `https://rkrenosolution.com${article.route}`,
      })),
    }]
  : serviceExact
  ? [{
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: page.title,
      description: page.description,
      url: page.canonical,
      areaServed: ['Kuala Lumpur', 'Selangor'],
      provider: { '@type': 'LocalBusiness', name: 'RK Reno Solution' },
    }, ...(serviceFaqsByRoute[page.path]?.length ? [{
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: serviceFaqsByRoute[page.path].map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    }] : [])]
  : batch3Pages[page.path]
  ? [{
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: batchPage?.title,
      description: batchPage?.summary,
      url: page.canonical,
      areaServed: 'Kuala Lumpur',
      provider: { '@type': 'Organization', name: 'RK Reno Solution' },
    }]
  : nativePage
  ? [{
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      '@id': page.canonical,
      url: page.canonical,
      name: batchPage?.title || page.title,
      description: batchPage?.summary || (page.path === '/faq/'
        ? 'Answers about renovation, aircond, electrical, waterproofing, ceiling, quotation and service areas.'
        : 'Practical renovation and property-service guides from RK Reno Solution.'),
      isPartOf: { '@id': 'https://rkrenosolution.com/#website' },
    }]
  : page.schema;
if ((batchArticle || nativeTaxonomy || isHeldRoute) && !pageSchema.some((item) => item['@type'] === 'BreadcrumbList')) pageSchema.push(breadcrumbSchema);
---
<BaseLayout
  title={layoutTitle}
  description={heldDescriptions[page.path] || nativeTaxonomy?.description || batchArticle?.summary || batchPage?.summary || (page.path === '/blog/'
    ? 'Practical renovation and property-service guides from RK Reno Solution.'
    : page.path === '/faq/'
      ? 'Answers about renovation, aircond, electrical, waterproofing, ceiling, quotation and service areas.'
      : page.description)}
  canonical={page.canonical}
  ogImage={catalogArticle?.image || page.og?.image}
  schema={pageSchema}
  pageType={batchArticle ? 'post' : page.type}
  externalStyles={nativePage ? [] : page.externalStyles}
  robots={nativeTaxonomy || isHeldRoute ? (isIndexable ? 'noindex, follow' : 'noindex, nofollow')
    : page.path === '/thank-you/' ? 'noindex, nofollow' : undefined}
  exactHome={page.path === '/'}
  wordpressCore={coreRoutes.includes(page.path) || Boolean(serviceExact) || Boolean(batchArticle) || Boolean(nativeTaxonomy) || isHeldRoute || isDemolition || page.path === '/thank-you/'}
>
  {isDemolition ? (
    <DemolitionPage />
  ) : page.path === '/company-history/' ? (
    <CompanyHistoryPage content={repairedContent} />
  ) : page.path === '/our-projects/' ? (
    <ProjectsArchivePage content={repairedContent} />
  ) : page.path === '/our-projects-2/' ? (
    <ProjectsAlternatePage content={repairedContent} />
  ) : page.path === '/our-team/' ? (
    <TeamPage content={repairedContent} />
  ) : page.path === '/testimonials/' ? (
    <TestimonialsPage content={repairedContent} />
  ) : batchArticle ? (
    <ArticlePage article={batchArticle} wordpressContent={exactArticle} sourceContent={content} sourceTitle={sourceHeroTitle || page.h1} />
  ) : page.path === '/' ? (
    <ExactHomePage />
  ) : page.path === '/services/' ? (
    <CoreServicesPage />
  ) : page.path === '/about-us/' ? (
    <CoreAboutPage />
  ) : page.path === '/contact-us/' ? (
    <CoreContactPage />
  ) : page.path === '/faq/' ? (
    <CoreFaqPage />
  ) : page.path === '/blog/' ? (
    <CoreBlogPage />
  ) : serviceExact && parityContent ? (
    <ServiceExactPage
      route={page.path}
      title={parityContent.sourceH1 || page.title}
      sourceHeroTitle={sourceHeroTitle}
      sourceHeroLead={sourceHeroLead}
      sourceHeroActions={sourceHeroActions}
      parityContent={parityContent}
    />
  ) : page.path === '/thank-you/' ? (
    <ThankYouPage />
  ) : nativeTaxonomy ? (
    <TaxonomyArchive archive={nativeTaxonomy} articles={taxonomyArticles} path={page.path} sourceH1={page.h1} />
  ) : batchPage ? (
    <Batch1Page page={batchPage} path={page.path} parityContent={parityContent} sourceH1={parityContent?.sourceH1} />
  ) : (
    <>
  {page.path !== '/' && !page.customLayout && (
    <>
      <section class="page-hero">
        <div class="wrap">
          <p class="eyebrow">{page.type}</p>
          <h1>{page.h1 || page.title}</h1>
        </div>
      </section>
      <Breadcrumbs path={page.path} title={page.h1 || page.title} />
    </>
  )}
  {page.path !== '/' && page.customLayout && (
    <PriorityPageHero
      title={page.h1 || page.title}
      description={page.path === '/services/'
        ? 'Our expertise combines visionary design with practical execution, ensuring functional, beautiful spaces that meet the demands of modern life and exceed expectations.'
        : 'Description Details'}
    />
  )}
  <article
    class:list={[
      page.customLayout ? 'custom-content' : 'legacy-content',
      {
        'home-content': page.path === '/',
        'theme-content': Boolean(page.externalStyles?.length)
      }
    ]}
    set:html={content}
  />
    </>
  )}
  {showDemolitionLink && (
    <aside class="demolition-related">
      <div class="exact-wrap">
        <p><strong>Planning strip-out or removal before renovation?</strong> Review our <a href={`${base}/demolition-contractor-kl-selangor/`}>demolition enquiry service for KL and Selangor</a>.</p>
      </div>
    </aside>
  )}
  {showForm && (
    <section class="section-space form-section">
      <div class="wrap">
        <div class="section-heading">
          <p class="eyebrow">Enquiry form</p>
          <h2>Send Your Project Details</h2>
        </div>
        <ContactForm />
      </div>
    </section>
  )}
</BaseLayout>
