---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import StagingBanner from '@components/StagingBanner.astro';
import TrackingBody from '@components/TrackingBody.astro';
import TrackingHead from '@components/TrackingHead.astro';
import AnalyticsConsent from '@components/AnalyticsConsent.astro';
import { isIndexable, publicConfig } from '../config/runtime';
import '../styles/global.css';
import '../styles/parity.css';
import '../styles/homepage-exact.css';
import '../styles/homepage-exact-responsive.css';
import '../styles/core-wordpress.css';
import '../styles/core-wordpress-responsive.css';
import '../styles/service-exact.css';
import '../styles/service-exact-responsive.css';
import '../styles/article-exact.css';
import '../styles/article-exact-responsive.css';
import '../styles/prompt-2-1.css';
import '../styles/prompt-2-2.css';
import '../styles/prompt-2-3.css';
import '../styles/final-ditto.css';
import '../styles/held-wordpress-pages.css';
import '../styles/tokens.css';
import '../styles/shared-foundations.css';
import '../styles/shared-icon-fonts.css';
import '../styles/shared-header.css';
import '../styles/shared-header-mobile.css';
import '../styles/shared-footer.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  schema?: unknown[];
  pageType?: string;
  externalStyles?: string[];
  robots?: string;
  exactHome?: boolean;
  wordpressCore?: boolean;
}

const {
  title,
  description = 'Renovation, repair and installation services in Kuala Lumpur and Selangor.',
  canonical = 'https://rkrenosolution.com/',
  ogImage,
  schema = [],
  pageType = 'website',
  externalStyles = [],
  robots,
  exactHome = false,
  wordpressCore = false
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const socialImage = ogImage || '/assets/media/RK-Reno-Solutions-Logo-942f64bb.png';
const image = socialImage.startsWith('http')
  ? socialImage
  : new URL(`${base}${socialImage}`, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots || (isIndexable ? 'index, follow' : 'noindex, nofollow')} />
    <meta property="og:type" content={pageType === 'post' ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f47b20" />
    <link rel="icon" type="image/png" href={`${base}/assets/media/logo-iocn-6f17c44e.png`} />
    <TrackingHead />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Maven+Pro:wght@400..900&family=Syne:wght@400..800&display=swap&subset=latin%2Clatin-ext"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css?family=Roboto:100,100italic,200,200italic,300,300italic,400,400italic,500,500italic,600,600italic,700,700italic,800,800italic,900,900italic&display=swap"
      rel="stylesheet"
    />
    {externalStyles.map((href) => <link rel="stylesheet" href={href} />)}
    {publicConfig.turnstileSiteKey && (
      <>
        <link rel="preconnect" href="https://challenges.cloudflare.com" />
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
      </>
    )}
    {schema.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <TrackingBody />
    <a class="skip-link" href="#main-content">Skip to content</a>
    <StagingBanner />
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
    <AnalyticsConsent />
    <script>
      import { bootEnquiryForms } from '../scripts/enquiry-form-client';
      import { bootSharedChrome } from '../scripts/shared-chrome';
      bootEnquiryForms('[data-core-enquiry-form], [data-preview-form]');
      bootSharedChrome();
    </script>
  </body>
</html>
