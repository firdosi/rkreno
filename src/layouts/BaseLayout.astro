---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import ExactHomeHeader from '@components/home/ExactHomeHeader.astro';
import ExactHomeFooter from '@components/home/ExactHomeFooter.astro';
import ContactActions from '@components/ContactActions.astro';
import StagingBanner from '@components/StagingBanner.astro';
import TrackingBody from '@components/TrackingBody.astro';
import TrackingHead from '@components/TrackingHead.astro';
import { isIndexable, publicConfig } from '../config/runtime';
import '../styles/global.css';
import '../styles/parity.css';
import '../styles/core-wordpress.css';
import '../styles/core-wordpress-responsive.css';
import '../styles/service-exact.css';
import '../styles/service-exact-responsive.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  schema?: unknown[];
  pageType?: string;
  externalStyles?: string[];
  robots?: string;
  exactHome?: boolean;
  wordpressCore?: boolean;
}

const {
  title,
  description = 'Renovation, repair and installation services in Kuala Lumpur and Selangor.',
  canonical = 'https://rkrenosolution.com/',
  ogImage,
  schema = [],
  pageType = 'website',
  externalStyles = [],
  robots,
  exactHome = false,
  wordpressCore = false
} = Astro.props;
const useWordpressChrome = exactHome || wordpressCore;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const socialImage = ogImage || '/assets/media/RK-Reno-Solutions-Logo-942f64bb.png';
const image = socialImage.startsWith('http')
  ? socialImage
  : new URL(`${base}${socialImage}`, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots || (isIndexable ? 'index, follow' : 'noindex, nofollow')} />
    <meta property="og:type" content={pageType === 'post' ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f47b20" />
    <link rel="icon" type="image/png" href={`${base}/assets/media/logo-iocn-6f17c44e.png`} />
    <TrackingHead />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Maven+Pro:wght@500;600;700&family=Roboto:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    {externalStyles.map((href) => <link rel="stylesheet" href={href} />)}
    {publicConfig.turnstileSiteKey && (
      <>
        <link rel="preconnect" href="https://challenges.cloudflare.com" />
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
      </>
    )}
    {schema.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <TrackingBody />
    <a class="skip-link" href="#main-content">Skip to content</a>
    <StagingBanner />
    {useWordpressChrome ? <ExactHomeHeader /> : <Header />}
    <main id="main-content"><slot /></main>
    {useWordpressChrome ? <ExactHomeFooter /> : <Footer />}
    <ContactActions />
  </body>
</html>
