# REQUIRED BEFORE PRIVATE PREVIEW — NON-SECRET
ENQUIRY_SERVICE_HOST=127.0.0.1
ENQUIRY_SERVICE_PORT=4174
RKRENO_ROOT=/var/www/rkreno
FORM_ENABLED=false
FORM_ENVIRONMENT=disabled
FORM_ALLOWED_ORIGINS=REPLACE_WITH_APPROVED_ORIGIN
FORM_RECIPIENT_EMAIL=REPLACE_WITH_OWNER_APPROVED_RECIPIENT
FORM_SENDER_EMAIL=REPLACE_WITH_VERIFIED_DOMAIN_SENDER
FORM_MAIL_MODE=dry_run
SMTP_HOST=REPLACE_WITH_PROVIDER_HOST
SMTP_PORT=587
SMTP_SECURE=false
# REQUIRED ONLY WHEN SMTP DELIVERY IS APPROVED — SECRET
SMTP_USERNAME=REPLACE_WITH_PROVIDER_USERNAME
SMTP_PASSWORD=REPLACE_WITH_PROVIDER_PASSWORD
TURNSTILE_SECRET_KEY=REPLACE_WITH_SERVER_SECRET
# REQUIRED BEFORE THE CORRESPONDING PREVIEW/PRODUCTION WIDGET IS ENABLED — NON-SECRET
TURNSTILE_EXPECTED_HOSTNAME=REPLACE_WITH_APPROVED_HOSTNAME
TURNSTILE_EXPECTED_ACTION=enquiry
# SAFETY LOCK — MUST REMAIN FALSE UNTIL AN EXPLICITLY AUTHORIZED REMOTE STEP
RKRENO_VPS_DEPLOY_ENABLED=false
