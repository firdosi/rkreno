# REQUIRED BEFORE PRIVATE PREVIEW — NON-SECRET
PREVIEW_HOSTNAME=REPLACE_WITH_APPROVED_PRIVATE_PREVIEW_HOSTNAME
PREVIEW_ACCESS_MODE=REPLACE_WITH_BASIC_AUTH_OR_IP_RESTRICTION
# REQUIRED BEFORE PRIVATE PREVIEW — SECRET FILE PATH; password remains outside Git
PREVIEW_BASIC_AUTH_FILE=REPLACE_WITH_EXTERNAL_AUTH_FILE
# REQUIRED BEFORE PRIVATE PREVIEW — NON-SECRET
FORM_ENABLED=true
FORM_ENVIRONMENT=private_preview
FORM_ALLOWED_ORIGINS=https://REPLACE_WITH_APPROVED_PRIVATE_PREVIEW_HOSTNAME
FORM_MAIL_MODE=test_capture
FORM_RECIPIENT_EMAIL=REPLACE_WITH_TEST_RECIPIENT
FORM_SENDER_EMAIL=REPLACE_WITH_VERIFIED_PREVIEW_SENDER
SMTP_HOST=REPLACE_WITH_PREVIEW_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
# OPTIONAL IN TEST_CAPTURE; SECRET if real preview delivery is later approved
SMTP_USERNAME=REPLACE_WITH_PREVIEW_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_PREVIEW_SMTP_PASSWORD
TURNSTILE_SITE_KEY=REPLACE_WITH_PREVIEW_SITE_KEY
TURNSTILE_SECRET_KEY=REPLACE_WITH_PREVIEW_SECRET_KEY
# REQUIRED BEFORE PRIVATE PREVIEW — NON-SECRET
TURNSTILE_EXPECTED_HOSTNAME=REPLACE_WITH_APPROVED_PRIVATE_PREVIEW_HOSTNAME
TURNSTILE_EXPECTED_ACTION=enquiry
# OPTIONAL UNTIL OWNER APPROVES PRIVATE ANALYTICS TESTING — NON-SECRET
PUBLIC_CONSENT_ENABLED=false
PUBLIC_ANALYTICS_ENABLED=false
# SAFETY LOCK — MUST REMAIN FALSE IN THIS TEMPLATE
RKRENO_VPS_DEPLOY_ENABLED=false
